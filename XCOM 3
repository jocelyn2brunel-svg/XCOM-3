        protected override void Update(GameTime gameTime) // Logique du jeu (appelé à chaque frame) // Classe héritée de Game
        {
            MouseState mouse = Mouse.GetState(); // État actuel de la souris           
            if (currentState == GameState.MainMenu) // Si on est dans le Main Menu
            {
                foreach (var button in menuButtons) // Vérifie les clics sur chaque bouton
                {
                    if (button.IsClicked(mouse, previousMouseState)) // Si le bouton de la souris est cliqué
                    {
                        switch (button.Text) // Action selon le texte du bouton
                        {
                            case "New Game":
                                //MediaPlayer.Stop(); // Stop la musique
                                currentState = GameState.Playing; // L'état du jeu deviens : New Game
                                LoadMap();
                                CreateUnits(); // Créer les unités au lancement de New Game - 1.5.0                          
                                Console.WriteLine("New game launched !");
                                break;
                            case "Continue":
                                Console.WriteLine("Continue a saved game...");
                                break;
                            case "Encylopedia":
                                Console.WriteLine("Open encyclopedia...");
                                break;
                            case "Options":
                                currentState = GameState.OptionsMenu; // L'état du jeu deviens : Menu Options
                                Console.WriteLine("Options");
                                break;
                            case "Quit":
                                Exit(); // Quitte le jeu
                                break;
                        }
                    }
                }
            }
            bool leftClick =
                mouse.LeftButton == ButtonState.Pressed &&
                previousMouseState.LeftButton == ButtonState.Released;
            if (currentState == GameState.Playing) // Si l'état du jeu est : New Game
            {
                int mouseX = mouse.X;
                int mouseY = mouse.Y;
                int cellX = mouseX / cellSize;
                int cellY = mouseY / cellSize;
                if (cellX >= 0 && cellX < gridWidth &&
                    cellY >= 0 && cellY < gridHeight)
                {
                    hoveredCell = new Point(cellX, cellY);
                }
                else
                {
                    hoveredCell = new Point(-1, -1);
                }
                if (leftClick)
                {
                    Point clickedCell = new Point(cellX, cellY);                   
                    Unit clickedUnit = GetUnitAtCell(clickedCell);
                    if (clickedUnit != null)
                    {
                        selectedUnit = clickedUnit;
                    }
                    else if (selectedUnit != null)
                    {
                        var movableCells = GetMovableCells(selectedUnit);
                        if (movableCells.Contains(clickedCell))
                        {
                            selectedUnit.Cell = clickedCell;
                        }
                    }
                }
                if (mouse.RightButton == ButtonState.Pressed &&
                    previousMouseState.RightButton == ButtonState.Released)
                {
                    selectedUnit = null;
                }
            }
            if (currentState == GameState.OptionsMenu) // Détecter les clics dans le Menu Options // 1.4.0
            {
                foreach (var button in optionsButtons)
                {
                    if (button.IsClicked(mouse, previousMouseState))
                    {
                        switch (button.Text)
                        {
                            case "Music Volume +":
                                musicVolume += 0.1f;
                                if (musicVolume > 1f) musicVolume = 1f;
                                MediaPlayer.Volume = musicVolume;
                                Console.WriteLine("Volume: " + musicVolume);
                                break;
                            case "Music Volume -":
                                musicVolume -= 0.1f;
                                if (musicVolume < 0f) musicVolume = 0f;
                                MediaPlayer.Volume = musicVolume;
                                Console.WriteLine("Volume: " + musicVolume);
                                break;
                            case "Back":
                                currentState = GameState.MainMenu;
                                break;
                        }
                    }
                }
                // Logique du slider(Update – OptionsMenu) 1.4.1
                if (mouse.LeftButton == ButtonState.Pressed && // Détection clic / drag
                    volumeBar.Contains(mouse.Position))
                {
                    draggingVolume = true;
                }
                if (mouse.LeftButton == ButtonState.Released)
                {
                    draggingVolume = false;
                }
                if (draggingVolume)
                {
                    float percent =
                        (mouse.X - volumeBar.X) / (float)volumeBar.Width;

                    musicVolume = MathHelper.Clamp(percent, 0f, 1f);
                    MediaPlayer.Volume = musicVolume;
                }
                volumeFill = new Rectangle( // Mise à jour des rectangles visuels
                    volumeBar.X,
                    volumeBar.Y,
                    (int)(volumeBar.Width * musicVolume),
                    volumeBar.Height);
                int handleX = volumeBar.X + volumeFill.Width - 5;
                volumeHandle = new Rectangle(
                    handleX,
                    volumeBar.Y - 4,
                    10,
                    volumeBar.Height + 8);
            }
            previousMouseState = mouse; // Sauvegarde l’état actuel pour la frame suivante
            if (Keyboard.GetState().IsKeyDown(Keys.Escape)) // Quitte le jeu si ESC est appuyé
                Exit();
            base.Update(gameTime);
        }
        protected override void Draw(GameTime gameTime) // Dessin à l’écran (appelé à chaque frame) // Classe héritée de Game
        {
            GraphicsDevice.Clear(Color.Black); // Nettoie l’écran en noir
            _spriteBatch.Begin();
            if (currentState == GameState.MainMenu) // Si on est dans le Main Menu
            {
                string title = "XCOM 3"; // Texte du titre
                Vector2 position = new Vector2(0, 0); // Position du titre (posX, posY)
                float scale = 3f; // Échelle du texte (3x plus grand)
                _spriteBatch.DrawString( // Dessine le titre
                    font,
                    title,
                    position,
                    Color.White,
                    0f,
                    Vector2.Zero,
                    scale,
                    SpriteEffects.None,
                    0f
                );
                MouseState mouse = Mouse.GetState(); // État actuel de la souris
                foreach (var button in menuButtons) // Dessine chaque bouton
                {
                    button.Draw(_spriteBatch, font, mouse);
                }
            }
            else if (currentState == GameState.Playing) // Si on est dans New Game
            {
                DrawGrid(); // Dessiner la carte isométrique
                DrawUnits(); // ÉTAPE 5 — Appeler le dessin des unités - 1.5.0
                DrawHoveredCell(); // <-- SURBRILLANCE
                if (currentState == GameState.Playing && selectedUnit != null) // Dessiner les cases accessibles - 1.5.2
                {
                    var movableCells = GetMovableCells(selectedUnit);
                    foreach (var cell in movableCells)
                    {
                        Rectangle rect = new Rectangle(cell.X * cellSize, cell.Y * cellSize, cellSize, cellSize);
                        _spriteBatch.Draw(pixel, rect, new Color(0, 255, 0, 80)); // vert transparent
                    }
                }
                DrawUnitInfoPanel(); // - 1.5.1
            }
            else if (currentState == GameState.OptionsMenu) // Si on est dans Options // - 1.4.0
            {
                string title = "Options";
                _spriteBatch.DrawString(font, title, new Vector2(0, 0), Color.White, 0f, Vector2.Zero, 3f, SpriteEffects.None, 0f);
                MouseState mouse = Mouse.GetState();
                foreach (var button in optionsButtons)
                {
                    button.Draw(_spriteBatch, font, mouse);
                }
                // Dessin du slider (Draw – OptionsMenu) - 1.4.1
                // _spriteBatch.DrawString(font, "Options", new Vector2(0, 0), Color.White, 0f, Vector2.Zero, 3f, SpriteEffects.None, 0f); // Déjà intégré dans 1.4.0
                // _spriteBatch.DrawString(font, "Music Volume", new Vector2(0, 100), Color.White); // Semble superflu
                _spriteBatch.Draw(pixel, volumeBar, Color.Gray); // Barre de fond
                _spriteBatch.Draw(pixel, volumeFill, Color.Yellow); // Niveau de volume
                _spriteBatch.Draw(pixel, volumeHandle, Color.White); // Poignée de la barre de volume
            }
            _spriteBatch.End();
            base.Draw(gameTime);
        }
        private void LoadMap() // Informations de la grille
        {
            gridWidth = 20; // Pour l’instant, on ne charge que la taille de la grille
            gridHeight = 15; // Plus tard : tilemap, collisions, unités, etc.
            cellSize = 32;
            Console.WriteLine("Map loaded");
        }
        private void DrawGrid()        // Dessin de la grille 2D
        {
            Color gridColor = new Color(255, 255, 255, 80);
            for (int x = 0; x <= gridWidth; x++) // Lignes verticales
            {
                _spriteBatch.Draw(
                    pixel,
                    new Rectangle(
                        x * cellSize,
                        0,
                        1,
                        gridHeight * cellSize),
                    gridColor);
            }
            for (int y = 0; y <= gridHeight; y++) // Lignes horizontales
            {
                _spriteBatch.Draw(
                    pixel,
                    new Rectangle(
                        0,
                        y * cellSize,
                        gridWidth * cellSize,
                        1),
                    gridColor);
            }
        }
        private void DrawHoveredCell() // Highlight des cases de la grille // 1.3.1
        {
            if (hoveredCell.X < 0 || hoveredCell.Y < 0)
                return;
            Rectangle cellRect = new Rectangle(
                hoveredCell.X * cellSize,
                hoveredCell.Y * cellSize,
                cellSize,
                cellSize);
            Color highlightColor = new Color(255, 255, 0, 80); // Couleur de surbrillance - Yellow
            _spriteBatch.Draw(pixel, cellRect, highlightColor);
        }
        private void CreateUnits() // Créer les unités au lancement de New Game - 1.5.0
        {
            playerUnits.Clear();
            enemyUnits.Clear();
            for (int i = 0; i < 6; i++) // ---- UNITÉS JOUEUR (en bas de la map) ----
            {
                playerUnits.Add(
                    new Unit(
                        new Point(2 + i, gridHeight - 2),
                        Team.Player,
                        "Soldier " + (i + 1), //1.5.1
                        "Assault", // 1.5.1
                        "Rifle" // 1.5.1
                    )
                );
            }
            for (int i = 0; i < 6; i++) // ---- UNITÉS ENNEMIES (en haut de la map) ----
            {
                enemyUnits.Add(
                    new Unit(
                        new Point(2 + i, 1),
                        Team.Enemy,
                        "Alien" + (i + 1), // 1.5.1
                        "Infantry", // 1.5.1
                        "Plasma Gun" // 1.5.1
                    )
                );
            }
            Console.WriteLine("Units created: 6 player, 6 enemy");
        }
        private void DrawUnits() // Dessiner les unités sur la grille - 1.5.0
        {
            foreach (var unit in playerUnits)
                DrawUnit(unit);

            foreach (var unit in enemyUnits)
                DrawUnit(unit);
        }
        private void DrawUnit(Unit unit) // 1.5.0
        {
            Rectangle rect = new Rectangle(
                unit.Cell.X * cellSize + 4,
                unit.Cell.Y * cellSize + 4,
                cellSize - 8,
                cellSize - 8
            );
            Color color = (unit.Team == Team.Player)
                ? Color.Blue
                : Color.Red;
            _spriteBatch.Draw(pixel, rect, color);
            if (unit == selectedUnit) // 1.5.1
            {
                Rectangle outline = new Rectangle(
                    unit.Cell.X * cellSize,
                    unit.Cell.Y * cellSize,
                    cellSize,
                    cellSize
                );
                _spriteBatch.Draw(pixel, outline, new Color(0, 255, 255, 80));
            }
        }
        private IEnumerable<Unit> AllUnits()
        {
            foreach (var u in playerUnits) yield return u;
            foreach (var u in enemyUnits) yield return u;
        }
        private Unit GetUnitAtCell(Point cell)
        {
            foreach (var unit in AllUnits())
                if (unit.Cell == cell)
                    return unit;
            return null;
        }
        private void DrawUnitInfoPanel() // Panneau d’information (HUD) - 1.5.1
        {
            if (selectedUnit == null)
                return;
            int margin = 10; // marge par rapport aux bords de la fenêtre - 1.5.2
            int panelWidth = 300; // Longueur du HUD
            int panelHeight = 120; // Hauteur du HUD
            int panelX = margin; // Coin bas gauche relatif à la fenêtre
            int panelY = GraphicsDevice.Viewport.Height - panelHeight - margin;
            Rectangle panel = new Rectangle(panelX, panelY, panelWidth, panelHeight);
            _spriteBatch.Draw(pixel, panel, new Color(0, 0, 0, 180)); // Fond semi-transparent
            Vector2 textPos = new Vector2(panelX + 10, panelY + 10); // Texte avec un petit offset dans le panneau
            _spriteBatch.DrawString(font, "Name: " + selectedUnit.Name, textPos, Color.White);
            _spriteBatch.DrawString(font, "Class: " + selectedUnit.Class, textPos + new Vector2(0, 20), Color.White);
            _spriteBatch.DrawString(font, "Weapon: " + selectedUnit.Weapon, textPos + new Vector2(0, 40), Color.White);
        }
        private List<Point> GetMovableCells(Unit unit)
        {
            List<Point> cells = new List<Point>();
            if (unit == null)
                return cells;
            int range = unit.ActionPoints;
            for (int dx = -range; dx <= range; dx++)
            {
                for (int dy = -range; dy <= range; dy++)
                {
                    int distance = Math.Abs(dx) + Math.Abs(dy);
                    if (distance == 0 || distance > range) // ignore la case de départ, ignore les diagonales gratuites
                        continue;
                    int x = unit.Cell.X + dx;
                    int y = unit.Cell.Y + dy;
                    if (x < 0 || x >= gridWidth || // Grille
                        y < 0 || y >= gridHeight)
                        continue;
                    if (GetUnitAtCell(new Point(x, y)) != null) // Case occupée
                        continue;
                    cells.Add(new Point(x, y));
                }
            }
            return cells;
        }
