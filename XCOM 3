        // Cette fonction est appelée automatiquement par le moteur du jeu
        // Elle s’exécute à CHAQUE frame (ex : 60 fois par seconde)
        protected override void Update(GameTime gameTime)
        {
            // Je lis l’état actuel de la souris :
            // position + boutons pressés ou non
            MouseState mouse = Mouse.GetState();

            menuButtons[1].IsEnabled = hasSavedGame;


            // Est-ce que je suis actuellement dans le menu principal ?
            if (currentState == GameState.MainMenu)
            {
                // Oui → je parcours tous les boutons du menu principal
                foreach (var button in menuButtons)
                {
                    // Est-ce que ce bouton vient d’être cliqué ?
                    if (button.IsClicked(mouse, previousMouseState))
                    {
                        // Oui → je regarde quel bouton exactement
                        switch (button.Text) // Action selon le texte du bouton
                        {
                            case "New Game":
                                // Le joueur veut lancer une nouvelle partie

                                // (Optionnel) j’arrêterais la musique actuelle
                                // MediaPlayer.Stop();

                                // Je passe le jeu à l’état "Playing"
                                currentState = GameState.Playing;

                                // Je charge la carte du jeu
                                LoadMap();

                                // Je crée les unités de départ
                                CreateUnits();

                                // Message de debug
                                Console.WriteLine("New game launched !");
                                break;

                            case "Continue":
                                // Le joueur veut continuer une partie sauvegardée

                                if (hasSavedGame)
                                {
                                    // Recharger la partie sauvegardée
                                    playerUnits = new List<Unit>();
                                    foreach (var u in savedPlayerUnits)
                                        playerUnits.Add(new Unit(u.Cell, u.Team, u.Name, u.Class, u.Weapon) { ActionPoints = u.ActionPoints });

                                    enemyUnits = new List<Unit>();
                                    foreach (var u in savedEnemyUnits)
                                        enemyUnits.Add(new Unit(u.Cell, u.Team, u.Name, u.Class, u.Weapon) { ActionPoints = u.ActionPoints });

                                    currentState = GameState.Playing;
                                    Console.WriteLine("Game continued!");
                                }
                                else
                                {
                                    Console.WriteLine("No saved game to continue!");
                                }
                                break;

                            case "Encylopedia":
                                // Le joueur veut ouvrir l’encyclopédie
                                Console.WriteLine("Opening encyclopedia...");
                                break;

                            case "Options":
                                // Le joueur veut aller dans le menu Options
                                currentState = GameState.OptionsMenu;
                                Console.WriteLine("Options");
                                break;

                            case "Quit":
                                // Le joueur veut quitter le jeu
                                // Je ferme complètement l’application
                                Exit();
                                break;
                        }
                    }
                }
            }

            // Je crée une variable qui va me dire :
            // “Est-ce que le joueur vient JUSTE de cliquer gauche ?”
            bool leftClick =
                // Le bouton gauche est appuyé maintenant…
                mouse.LeftButton == ButtonState.Pressed &&
                // …mais il était relâché à l’image précédente
                previousMouseState.LeftButton == ButtonState.Released;

            // Je commence par vérifier : est-ce que le jeu est en train de se jouer ?
            if (currentState == GameState.Playing && currentTurn == TurnState.PlayerTurn)
            {

                // Convertir la position de la souris en coordonnées monde
                Vector2 mouseWorldPos = new Vector2(mouse.X, mouse.Y) + cameraOffset;

                // Je récupère la position actuelle de la souris en pixels
                int mouseX = mouse.X;
                int mouseY = mouse.Y;

                // Je convertis les pixels en coordonnées de cellule de la grille
                // (ex : si une cellule fait 32px, 64px = cellule 2)
                // Puis en cellule
                int cellX = (int)(mouseWorldPos.X / cellSize);
                int cellY = (int)(mouseWorldPos.Y / cellSize);

                float fireSpeed = 3f; // vitesse de l'animation

                // Je vérifie si la souris est DANS la grille
                if (cellX >= 0 && cellX < gridWidth &&
                    cellY >= 0 && cellY < gridHeight)
                {
                    // Oui → je mémorise la cellule survolée
                    hoveredCell = new Point(cellX, cellY);
                }
                else
                {
                    // Non → la souris est hors de la grille
                    hoveredCell = new Point(-1, -1); // Hors grille
                }

                // ===== Empêcher l'interaction grille quand la souris est sur le bouton TIRER =====
                if (selectedUnit != null && fireButton.Contains(mouse.Position))
                {
                    hoveredCell = new Point(-1, -1);
                }

                if (isTargeting && leftClick)
                {
                    Point clickedCell = new Point(cellX, cellY);
                    Unit target = GetUnitAtCell(clickedCell);

                    if (target != null && validFireTargets.Contains(target))
                    {
                        FireAtTarget(selectedUnit, target);
                        isTargeting = false;
                        validFireTargets.Clear();
                    }

                    return; // bloque les autres clics pendant le ciblage
                }

                // Maintenant, est-ce que le joueur a cliqué avec le bouton gauche ?
                if (leftClick)
                {
                    // Je transforme le clic en une cellule de la grille
                    Point clickedCell = new Point(cellX, cellY);

                    // Est-ce qu’il y a une unité sur cette cellule ?
                    Unit clickedUnit = GetUnitAtCell(clickedCell);

                    if (clickedUnit != null)
                    {
                        // Oui → le joueur vient de cliquer sur une unité
                        // Donc je la sélectionne
                        selectedUnit = clickedUnit;

                        // Et je calcule où elle peut se déplacer
                        cachedMovableCells = GetMovableCells(selectedUnit);
                    }
                    else if (selectedUnit != null)
                    {
                        // Non → il n’y a pas d’unité sous le clic
                        // MAIS une unité est déjà sélectionnée

                        // Vérifie qu'il reste au moins 1 point d'action
                        if (selectedUnit.ActionPoints > 0)
                        {

                            // Je récupère les cases où cette unité peut aller pour **un mouvement**
                            var movableCells = GetMovableCells(selectedUnit);

                            // Est-ce que la cellule cliquée est autorisée ?
                            if (movableCells.Contains(clickedCell))
                            {
                                // Calcul du coût en distance Manhattan
                                int cost = Math.Abs(clickedCell.X - selectedUnit.Cell.X) +
                                           Math.Abs(clickedCell.Y - selectedUnit.Cell.Y);

                                // Vérifie que le mouvement est possible pour la distance maximale
                                if (cost <= selectedUnit.MovementPoints)
                                {
                                    // Déplacer l’unité
                                    selectedUnit.Cell = clickedCell;

                                    // Retirer 1 point d’action pour ce mouvement
                                    selectedUnit.ActionPoints -= 1;

                                    // Calculer les cases uniquement si l'unité a encore des points d'action
                                    if (selectedUnit.ActionPoints > 0)
                                    {
                                        // Recalculer les déplacements possibles après le move
                                        cachedMovableCells = GetMovableCells(selectedUnit);
                                    }
                                    else
                                    {
                                        cachedMovableCells.Clear(); // pas de surbrillance si pas d'AP
                                    }
                                }
                            }
                        }
                    }
                }

                

                // Est-ce que le joueur vient JUSTE de cliquer avec le bouton droit ?
                if (mouse.RightButton == ButtonState.Pressed && // Le bouton droit est appuyé maintenant
                    previousMouseState.RightButton == ButtonState.Released) // …mais il était relâché juste avant
                {
                    // Oui → le joueur veut annuler sa sélection
                    // Je retire donc l’unité actuellement sélectionnée
                    selectedUnit = null;
                }
                // ===== Bouton TIRER =====
                fireButtonHovered = false;

                if (selectedUnit != null && selectedUnit.ActionPoints > 0)
                {
                    if (fireButton.Contains(mouse.Position))
                    {
                        fireButtonHovered = true;

                        if (leftClick)
                        {
                            EnterTargetingMode(selectedUnit);
                        }
                    }
                }

                endTurnHovered = endTurnButton.Contains(mouse.Position);

                if (endTurnHovered && leftClick && !isActionInProgress)
                {

                    StartEnemyTurn();
                }


            }

            if (currentState == GameState.Playing &&
                currentTurn == TurnState.EnemyTurn)
            {
                UpdateEnemyTurn();
            }


            // Je regarde d’abord : est-ce qu’on est dans le menu Options ?
            if (currentState == GameState.OptionsMenu) // Détecter les clics dans le Menu Options
            {
                // Je parcours tous les boutons du menu Options
                foreach (var button in optionsButtons)
                {
                    // Est-ce que ce bouton vient d’être cliqué ?
                    if (button.IsClicked(mouse, previousMouseState))
                    {
                        // Oui → je regarde quel bouton exactement
                        switch (button.Text)
                        {
                            case "Music Volume +":
                                // Le joueur veut augmenter le volume
                                musicVolume += 0.1f;

                                // Je m’assure de ne jamais dépasser le max (1.0)
                                if (musicVolume > 1f) musicVolume = 1f;

                                // J’applique le volume au lecteur audio
                                MediaPlayer.Volume = musicVolume;

                                // Debug : j’affiche le volume actuel
                                Console.WriteLine("Volume: " + musicVolume);
                                break;

                            case "Music Volume -":
                                // Le joueur veut diminuer le volume
                                musicVolume -= 0.1f;

                                // Je m’assure de ne jamais descendre sous 0
                                if (musicVolume < 0f) musicVolume = 0f;

                                // J’applique le nouveau volume
                                MediaPlayer.Volume = musicVolume;

                                // Debug
                                Console.WriteLine("Volume: " + musicVolume);
                                break;
                            case "Back":

                                // Le joueur veut quitter les options
                                // Je retourne au menu principal
                                currentState = GameState.MainMenu;
                                break;
                        }
                    }
                }

                // ===== Gestion du slider de volume =====

                // Est-ce que le joueur clique sur la barre de volume ?
                if (mouse.LeftButton == ButtonState.Pressed &&
                    volumeBar.Contains(mouse.Position))
                {
                    // Oui → on commence à glisser le slider
                    draggingVolume = true;
                }

                // Est-ce que le joueur a relâché le bouton ?
                if (mouse.LeftButton == ButtonState.Released)
                {
                    // Oui → on arrête de glisser
                    draggingVolume = false;
                }

                // Tant que le joueur glisse le slider
                if (draggingVolume)
                {
                    // Je calcule à quel pourcentage de la barre se trouve la souris
                    float percent =
                        (mouse.X - volumeBar.X) / (float)volumeBar.Width;

                    // Je transforme ce pourcentage en volume (0 à 1)
                    musicVolume = MathHelper.Clamp(percent, 0f, 1f);

                    // J’applique le volume en temps réel
                    MediaPlayer.Volume = musicVolume;
                }

                // ===== Mise à jour visuelle du slider =====

                // La partie remplie de la barre dépend du volume
                volumeFill = new Rectangle(
                    volumeBar.X,
                    volumeBar.Y,
                    (int)(volumeBar.Width * musicVolume),
                    volumeBar.Height);

                // Le curseur (handle) se place à la fin de la partie remplie
                int handleX = volumeBar.X + volumeFill.Width - 5;

                volumeHandle = new Rectangle(
                    handleX,
                    volumeBar.Y - 4,
                    10,
                    volumeBar.Height + 8);
            }
            previousMouseState = mouse; // Sauvegarde l’état actuel  de la souris pour la frame suivante

            KeyboardState keyboardState = Keyboard.GetState();

            // Déplacement caméra
            Vector2 move = Vector2.Zero;

            if (keyboardState.IsKeyDown(Keys.W)) move.Y -= 1;
            if (keyboardState.IsKeyDown(Keys.S)) move.Y += 1;
            if (keyboardState.IsKeyDown(Keys.A)) move.X -= 1;
            if (keyboardState.IsKeyDown(Keys.D)) move.X += 1;

            // Normaliser pour que la diagonale ne soit pas plus rapide
            if (move != Vector2.Zero) move.Normalize();

            // Déplacement selon vitesse et temps écoulé
            cameraOffset += move * cameraSpeed * (float)gameTime.ElapsedGameTime.TotalSeconds;

            if (keyboardState.IsKeyDown(Keys.Escape) && currentState == GameState.Playing)
            {
                // Sauvegarde la partie actuelle
                hasSavedGame = true;

                savedPlayerUnits = new List<Unit>();
                foreach (var u in playerUnits)
                    savedPlayerUnits.Add(new Unit(u.Cell, u.Team, u.Name, u.Class, u.Weapon) { ActionPoints = u.ActionPoints });

                savedEnemyUnits = new List<Unit>();
                foreach (var u in enemyUnits)
                    savedEnemyUnits.Add(new Unit(u.Cell, u.Team, u.Name, u.Class, u.Weapon) { ActionPoints = u.ActionPoints });

                // Retour au menu principal
                currentState = GameState.MainMenu;
            }

            if (keyboardState.IsKeyDown(Keys.Escape) && currentState == GameState.OptionsMenu)
            {
                // Retour au menu principal
                currentState = GameState.MainMenu;
            }

            if (currentState == GameState.Playing)
            {
                UpdateFiringAnimations(gameTime);
            }


            base.Update(gameTime); // Appel du moteur MonoGame
        }

        // Cette méthode est appelée automatiquement par le moteur
        // Elle sert UNIQUEMENT à dessiner ce que le joueur voit à l’écran
        protected override void Draw(GameTime gameTime) // Dessin à l’écran (appelé à chaque frame)
        {
            // Je commence par nettoyer l’écran
            // Tout est repeint en noir avant de redessiner
            GraphicsDevice.Clear(Color.Black);

            // Je démarre le SpriteBatch (obligatoire avant de dessiner du texte ou des sprites)
            _spriteBatch.Begin();

            // ===== MENU PRINCIPAL =====
            if (currentState == GameState.MainMenu)
            {
                // Je prépare le titre du jeu
                string title = "XCOM 3";

                // Je le place en haut à gauche de l’écran
                Vector2 position = new Vector2(0, 0);

                // Je veux un texte plus gros que la normale
                float scale = 3f;

                // Je dessine le titre à l’écran
                _spriteBatch.DrawString(
                    font,
                    title,
                    position,
                    Color.White,
                    0f,
                    Vector2.Zero,
                    scale,
                    SpriteEffects.None,
                    0f
                );

                // Je récupère l’état actuel de la souris
                MouseState mouse = Mouse.GetState();

                // Je dessine chaque bouton du menu principal
                foreach (var button in menuButtons)
                {
                    button.Draw(_spriteBatch, font, mouse);
                }
            }

            // ===== JEU EN COURS =====
            else if (currentState == GameState.Playing)
            {
                // Je dessine la grille (la carte)
                DrawGrid();

                // Je dessine toutes les unités
                DrawUnits();

                // Je surligne la case sous la souris
                DrawHoveredCell();

                // Si une unité est sélectionnée ET qu'elle a au moins 1 AP
                if (selectedUnit != null && selectedUnit.ActionPoints > 0)
                    // Je dessine les cases où elle peut se déplacer
                    foreach (var cell in cachedMovableCells)
                    {
                        // Je transforme la cellule (X,Y) en rectangle à l’écran
                        Rectangle rect = new Rectangle(
                            cell.X * cellSize - (int)cameraOffset.X,
                            cell.Y * cellSize - (int)cameraOffset.Y,
                            cellSize,
                            cellSize);

                        // Je dessine une surbrillance verte semi-transparente
                        _spriteBatch.Draw(pixel, rect, new Color(0, 255, 0, 80));
                    }
                // ===== Portée de tir =====
                // Si tu sélectionnes une unité, qu'il lui reste des points d'actions et que tu survoles le bouton "Tirer" :
                if (selectedUnit != null && selectedUnit.ActionPoints > 0 && fireButtonHovered)
                {
                    if (isTargeting)
                    {
                        foreach (var target in validFireTargets)
                        {
                            Rectangle rect = new Rectangle(
                                target.Cell.X * cellSize - (int)cameraOffset.X,
                                target.Cell.Y * cellSize - (int)cameraOffset.Y,
                                cellSize,
                                cellSize);

                            _spriteBatch.Draw(pixel, rect, new Color(255, 0, 0, 80));
                        }
                    }

                }



                int btnWidth = 140;
                int btnHeight = 36;

                endTurnButton = new Rectangle(
                    GraphicsDevice.Viewport.Width - btnWidth - 20,
                    GraphicsDevice.Viewport.Height - btnHeight - 20,
                    btnWidth,
                    btnHeight
                );

                Color btnColor = endTurnHovered ? Color.DarkRed : Color.Red;
                _spriteBatch.Draw(pixel, endTurnButton, btnColor);

                Vector2 txtSize = font.MeasureString("FIN DU TOUR");
                _spriteBatch.DrawString(
                    font,
                    "FIN DU TOUR",
                    new Vector2(
                        endTurnButton.X + (btnWidth - txtSize.X) / 2,
                        endTurnButton.Y + (btnHeight - txtSize.Y) / 2
                    ),
                    Color.White
                );


                // Je dessine le panneau d’informations de l’unité sélectionnée
                DrawUnitInfoPanel();
            }

            // ===== MENU OPTIONS =====
            else if (currentState == GameState.OptionsMenu)
            {
                // Je dessine le titre "Options"
                string title = "Options";
                _spriteBatch.DrawString(
                    font,
                    title,
                    new Vector2(0, 0),
                    Color.White,
                    0f,
                    Vector2.Zero,
                    3f,
                    SpriteEffects.None,
                    0f
                );

                // Je récupère l’état de la souris
                MouseState mouse = Mouse.GetState();

                // Je dessine tous les boutons du menu Options
                foreach (var button in optionsButtons)
                {
                    button.Draw(_spriteBatch, font, mouse);
                }

                // ===== Dessin du slider de volume =====

                // Je dessine la barre de fond
                _spriteBatch.Draw(pixel, volumeBar, Color.Gray);

                // Je dessine la partie remplie (niveau du volume)
                _spriteBatch.Draw(pixel, volumeFill, Color.Yellow);

                // Je dessine la poignée du slider
                _spriteBatch.Draw(pixel, volumeHandle, Color.White);
            }

            // Je termine le SpriteBatch
            _spriteBatch.End();

            // J’appelle le Draw de la classe de base (important)
            base.Draw(gameTime);
        }

        // Cette méthode initialise les informations de la grille de jeu
        // Pour l’instant, c’est très simple : juste la taille
        private void LoadMap()
        {
            // Combien de cases il y a en largeur
            gridWidth = 20;

            // Combien de cases il y a en hauteur
            gridHeight = 15;

            // Taille d’une case en pixels
            cellSize = 32;

            // Message pour savoir que la carte est chargée (debug)
            Console.WriteLine("Map loaded");
        }

        // Cette méthode dessine la grille 2D à l’écran
        private void DrawGrid()
        {
            // Couleur des lignes de la grille : blanc semi-transparent
            Color gridColor = new Color(255, 255, 255, 80);

            // ===== Lignes verticales =====
            for (int x = 0; x <= gridWidth; x++)
            {
                // Je dessine une ligne verticale à la position x
                _spriteBatch.Draw(
                    pixel, // petit carré blanc de 1x1 que je vais étirer
                    new Rectangle(
                        x * cellSize - (int)cameraOffset.X,           // position X de la ligne
                        0 - (int)cameraOffset.Y,                      // position Y (en haut de l’écran)
                        1,                      // largeur de la ligne (1 pixel)
                        gridHeight * cellSize), // hauteur de la ligne (tout le grid)
                    gridColor);
            }

            // ===== Lignes horizontales =====
            for (int y = 0; y <= gridHeight; y++)
            {
                // Je dessine une ligne horizontale à la position y
                _spriteBatch.Draw(
                    pixel, // encore le petit carré blanc
                    new Rectangle(
                        0 - (int)cameraOffset.X,                    // position X (à gauche de l’écran)
                        y * cellSize - (int)cameraOffset.Y,         // position Y
                        gridWidth * cellSize, // largeur de la ligne (tout le grid)
                        1),                   // hauteur de la ligne (1 pixel)
                    gridColor);
            }
        }

        // Cette méthode met en surbrillance la case que la souris survole
        private void DrawHoveredCell()
        {
            // Si la souris n’est pas sur une case valide (hors grille)
            if (hoveredCell.X < 0 || hoveredCell.Y < 0)
                return; // je ne fais rien

            // Je transforme la cellule survolée en rectangle à l’écran
            Rectangle cellRect = new Rectangle(
                hoveredCell.X * cellSize - (int)cameraOffset.X, // position X
                hoveredCell.Y * cellSize - (int)cameraOffset.Y, // position Y
                cellSize,                 // largeur
                cellSize);                // hauteur

            // Couleur de surbrillance : jaune semi-transparent
            Color highlightColor = new Color(255, 255, 0, 80);

            // Je dessine le rectangle sur la grille
            _spriteBatch.Draw(pixel, cellRect, highlightColor);
        }

