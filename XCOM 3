        // Dessin de la grille 2D
        private void DrawGrid()
        {
            Color gridColor = new Color(255, 255, 255, 80);

            // Lignes verticales
            for (int x = 0; x <= gridWidth; x++)
            {
                _spriteBatch.Draw(
                    pixel,
                    new Rectangle(
                        x * cellSize,
                        0,
                        1,
                        gridHeight * cellSize),
                    gridColor);
            }

            // Lignes horizontales
            for (int y = 0; y <= gridHeight; y++)
            {
                _spriteBatch.Draw(
                    pixel,
                    new Rectangle(
                        0,
                        y * cellSize,
                        gridWidth * cellSize,
                        1),
                    gridColor);
            }
        }



        // Highlight des cases de la grille
        private void DrawHoveredCell() // 1.3.1
        {
            if (hoveredCell.X < 0 || hoveredCell.Y < 0)
                return;

            Rectangle cellRect = new Rectangle(
                hoveredCell.X * cellSize,
                hoveredCell.Y * cellSize,
                cellSize,
                cellSize);

            // Couleur de surbrillance
            Color highlightColor = new Color(255, 255, 0, 80); // Yellow

            _spriteBatch.Draw(pixel, cellRect, highlightColor);
        }

        // Créer les unités au lancement de New Game - 1.5.0
        private void CreateUnits()
        {
            playerUnits.Clear();
            enemyUnits.Clear();

            // ---- UNITÉS JOUEUR (en bas de la map) ----
            for (int i = 0; i < 6; i++)
            {
                playerUnits.Add(
                    new Unit(
                        new Point(2 + i, gridHeight - 2),
                        Team.Player,
                        "Soldier " + (i + 1), //1.5.1
                        "Assault", // 1.5.1
                        "Rifle" // 1.5.1
                    )
                );
            }

            // ---- UNITÉS ENNEMIES (en haut de la map) ----
            for (int i = 0; i < 6; i++)
            {
                enemyUnits.Add(
                    new Unit(
                        new Point(2 + i, 1),
                        Team.Enemy,
                        "Alien" + (i + 1), // 1.5.1
                        "Infantry", // 1.5.1
                        "Plasma Gun" // 1.5.1
                    )
                );
            }

            Console.WriteLine("Units created: 6 player, 6 enemy");
        }

        // ÉTAPE 4 — Dessiner les unités sur la grille - 1.5.0
        private void DrawUnits()
        {
            foreach (var unit in playerUnits)
                DrawUnit(unit);

            foreach (var unit in enemyUnits)
                DrawUnit(unit);
        }

        // 1.5.0
        private void DrawUnit(Unit unit)
        {
            Rectangle rect = new Rectangle(
                unit.Cell.X * cellSize + 4,
                unit.Cell.Y * cellSize + 4,
                cellSize - 8,
                cellSize - 8
            );

            Color color = (unit.Team == Team.Player)
                ? Color.Blue
                : Color.Red;

            // Si l'unité est une cible possible de l'unité sélectionnée
            if (selectedUnit != null && unit.Team != selectedUnit.Team)
            {
                Point[] directions = new Point[]
                {
        new Point(0,-1), new Point(0,1), new Point(-1,0), new Point(1,0)
                };

                foreach (var dir in directions)
                {
                    Point check = new Point(selectedUnit.Cell.X + dir.X, selectedUnit.Cell.Y + dir.Y);
                    if (check == unit.Cell)
                    {
                        color = Color.OrangeRed; // cible ennemie
                    }
                }
            }

            _spriteBatch.Draw(pixel, rect, color);

            // 1.5.1
            if (unit == selectedUnit)
            {
                Rectangle outline = new Rectangle(
                    unit.Cell.X * cellSize,
                    unit.Cell.Y * cellSize,
                    cellSize,
                    cellSize
                );

                _spriteBatch.Draw(pixel, outline, new Color(0, 255, 255, 80));
            }
            
        }


        // 1.5.1
        private Unit GetUnitAtCell(Point cell)
        {
            foreach (var unit in playerUnits)
            {
                if (unit.Cell == cell)
                    return unit;
            }
            foreach (var unit in enemyUnits)
            {
                if (unit.Cell == cell)
                    return unit;
            }
            return null;
        }


        // Panneau d’information (HUD) - 1.5.1
        private void DrawUnitInfoPanel()
        {
            if (selectedUnit == null)
                return;

            // 1.5.2
            int margin = 10; // marge par rapport aux bords de la fenêtre

            // Taille du HUD
            int panelWidth = 300;
            int panelHeight = 120;

            // Coin bas gauche relatif à la fenêtre
            int panelX = margin;
