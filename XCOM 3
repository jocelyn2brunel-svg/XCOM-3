            // Charge la police de caractères "Arial" depuis le dossier Content
            font = Content.Load<SpriteFont>("Arial");

            // Crée la liste des boutons du menu principal avec leur texte et position à l'écran
            menuButtons = new List<Button>
            {
                new Button("New Game", new Vector2(0, 100)),
                new Button("Continue", new Vector2(0, 128)),
                new Button("Encyclopedia", new Vector2(0, 156)),
                new Button("Options", new Vector2(0, 184)),
                new Button("Quit", new Vector2(0, 212))
            };

            // Crée et charge la liste de musiques pour le menu
            menuSongs = new List<Song>
            {
                Content.Load<Song>("menu_music_1"),
                Content.Load<Song>("menu_music_2"),
                Content.Load<Song>("menu_music_3"),
                Content.Load<Song>("menu_music_4")
            };

            // Sélectionne une musique aléatoire parmi la liste et la joue
            currentSong = menuSongs[random.Next(menuSongs.Count)];
            MediaPlayer.Play(currentSong);

            // Définit le volume du MediaPlayer (50%)
            MediaPlayer.Volume = 0.5f;

            // Charge les textures pour la grille et les obstacles
            tileTexture = Content.Load<Texture2D>("TileParchment32x32");
            obstacleTexture = Content.Load<Texture2D>("Crate32x32");

            // Crée une texture 1x1 blanche, utile pour dessiner des rectangles et lignes simples
            pixel = new Texture2D(GraphicsDevice, 1, 1);
            pixel.SetData(new[] { Color.White });

            // Crée les boutons de l'écran Options
            optionsButtons = new List<Button>
            {
                new Button("Music Volume +", new Vector2(0, 100)),
                new Button("Music Volume -", new Vector2(0, 156)),
                new Button("Back", new Vector2(0, 184))
            };

            // Définition d'une barre de volume (rectangle à l'écran)
            int barWidth = 200;
            int barHeight = 8;
            volumeBar = new Rectangle(0, 134, barWidth, barHeight);

            // Attache un événement pour mettre à jour les positions des icônes de cibles de tir si la fenêtre change de taille
            Window.ClientSizeChanged += (s, e) => UpdateFireTargetsUIPositions();

            // Initialise la base de données d'armes (nom, dégâts, précision, portée)
            InitializeWeapons();
        }



        protected override void Update(GameTime gameTime)
        {
            // --- 1. Lecture de l'état de la souris ---
            MouseState mouse = Mouse.GetState();

            // Active ou désactive le bouton "Continue" selon s'il existe une partie sauvegardée
            menuButtons[1].IsEnabled = hasSavedGame;

            // --- 2. GESTION DU MENU PRINCIPAL ---
            // Ce bloc ne s'exécute que si le jeu est dans l'état du menu principal.
            if (currentState == GameState.MainMenu)
            {
                HandleMainMenu(mouse);
            }

            // --- 3. Détection du clic gauche ---
            bool leftClick =
                mouse.LeftButton == ButtonState.Pressed &&
                previousMouseState.LeftButton == ButtonState.Released;

            // --- 4. GESTION DU TOUR DU JOUEUR ---
            // Ce bloc ne s'exécute que si le jeu est en cours et que c'est le tour du joueur.
            if (currentState == GameState.Playing && currentTurn == TurnState.PlayerTurn)
            {
                HandlePlayerTurn(mouse, leftClick);
            }


            // --- 5. GESTION DU TOUR DE L'ENNEMI ---
            // Vérifie que le jeu est en cours et que c'est le tour de l'ennemi
            if (currentState == GameState.Playing &&
                currentTurn == TurnState.EnemyTurn)
            {
                // Appelle la fonction qui fait agir tous les ennemis
                // : déplacement, tir, consommation des points d'action
                UpdateEnemyTurn();
            }


            // --- 6. GESTION DU JEU ---
            if (currentState == GameState.Playing)
            {
                HandleZoom();
                HandleCameraMovement(gameTime, mouse);
            }


            // --- 7. GESTION DU MENU OPTIONS ---
            if (currentState == GameState.OptionsMenu)
            {
                HandleOptionsMenu(mouse);
            }


            // --- 8. GESTION DU CLAVIER POUR CAMERA ET ESCAPE ---

            // Récupère l'état actuel du clavier
            KeyboardState keyboardState = Keyboard.GetState();

            // Détecte si la touche ESCAPE vient juste d'être pressée
            // true uniquement si la touche est enfoncée maintenant et était relâchée précédemment
            bool escapePressed = keyboardState.IsKeyDown(Keys.Escape) &&
                                 previousKeyboardState.IsKeyUp(Keys.Escape);       


            // --- 9. ESCAPE : sauvegarde et retour au menu ---
            if (escapePressed && currentState == GameState.Playing)
            {
                // Indique qu'une partie sauvegardée existe
                hasSavedGame = true;

                // Copie des unités du joueur dans une liste de sauvegarde
                savedPlayerUnits = new List<Unit>();
                foreach (var u in playerUnits)
                    savedPlayerUnits.Add(new Unit(u)); // copie chaque unité pour ne pas modifier l’originale

                // Copie des unités ennemies dans une liste de sauvegarde
                savedEnemyUnits = new List<Unit>();
                foreach (var u in enemyUnits)
                    savedEnemyUnits.Add(new Unit(u));

                // Retour au menu principal
                currentState = GameState.MainMenu;
            }

            // Si Escape est pressé depuis le menu Options
            if (escapePressed && currentState == GameState.OptionsMenu)
            {
                // Retour au menu principal sans sauvegarde (aucune partie en cours)
                currentState = GameState.MainMenu;
            }


            // --- 10. MISE À JOUR DES ANIMATIONS DE TIR ---
            if (currentState == GameState.Playing)
            {
                UpdateFiringAnimations(gameTime);
            }

            // --- 11. Sauvegarde des états précédents pour le prochain frame ---
            // On stocke l'état actuel de la souris et du clavier afin de pouvoir
            // détecter les changements (clics ou touches pressées/released) lors du prochain Update.
            previousMouseState = mouse;
            previousKeyboardState = keyboardState;

            // Appel de la méthode Update de la classe parent (Game)
            // Ceci est obligatoire pour que XNA/MonoGame gère correctement les composants et le cycle de jeu.
            base.Update(gameTime);

        }

        protected override void Draw(GameTime gameTime)
        {
            // --- 1. Nettoie l'écran ---
            GraphicsDevice.Clear(Color.Black);

            // --- 2. Transformation de la caméra ---
            // Cette matrice permet de gérer le décalage (cameraOffset) et le zoom
            Matrix transform =
                Matrix.CreateTranslation(new Vector3(-cameraOffset, 0)) *   // translation inverse pour simuler la caméra
                Matrix.CreateScale(zoom, zoom, 1) *                        // zoom
                Matrix.CreateTranslation(new Vector3(GraphicsDevice.Viewport.Width / 2,
                                                     GraphicsDevice.Viewport.Height / 2, 0)); // recentrage

            // --- 3. DESSIN DU JEU EN COURS ---
            if (currentState == GameState.Playing)
            {
                _spriteBatch.Begin(transformMatrix: transform); // commence le batch avec transformation caméra

                DrawGrid();        // dessine la grille
                DrawUnits();       // dessine toutes les unités
                DrawHoveredCell(gameTime); // dessine la cellule survolée avec pulsation

                // --- 3a. Cellules accessibles pour le mouvement ---
                if (selectedUnit != null && selectedUnit.ActionPoints > 0 && currentTurn == TurnState.PlayerTurn)
                    if (selectedUnit.Team == Team.Player)
                        foreach (var cell in cachedMovableCells)
                        {
                            Rectangle rect = new Rectangle(cell.X * cellSize, cell.Y * cellSize, cellSize, cellSize);
                            _spriteBatch.Draw(pixel, rect, new Color(0, 255, 0, 80)); // vert semi-transparent
                        }

                // --- 3b. Flèche de déplacement ---
                if (showMoveArrow && selectedUnit != null && selectedUnit.Team == Team.Player)
                {
                    Vector2 fromWorld = new Vector2(arrowFromCell.X * cellSize + cellSize / 2,
                                                    arrowFromCell.Y * cellSize + cellSize / 2);
                    Vector2 toWorld = new Vector2(arrowToCell.X * cellSize + cellSize / 2,
                                                  arrowToCell.Y * cellSize + cellSize / 2);
                    // pulsation pour effet visuel
                    float pulse = (float)Math.Sin(gameTime.TotalGameTime.TotalSeconds * 6f) * 0.2f;
                    Color arrowColor = Color.CornflowerBlue * (0.7f + pulse * 0.3f);
                    DrawArrow(_spriteBatch, fromWorld, toWorld, arrowColor);
                }

                _spriteBatch.End(); // fin du batch pour le monde
            }

            // --- 4. DESSIN DE L'UI (toujours sans transformation caméra) ---
            _spriteBatch.Begin();

            // --- 4a. Menu principal ---
            if (currentState == GameState.MainMenu)
            {
                string title = "XCOM 3";
                _spriteBatch.DrawString(font, title, Vector2.Zero, Color.White, 0f, Vector2.Zero, 3f, SpriteEffects.None, 0f);

                MouseState mouse = Mouse.GetState();
                foreach (var button in menuButtons) button.Draw(_spriteBatch, font, mouse);
            }

            // --- 4b. UI du jeu ---
            else if (currentState == GameState.Playing)
            {
                // --- Bouton FIN DU TOUR ---
                int btnWidth = 140, btnHeight = 36;
                endTurnButton = new Rectangle(GraphicsDevice.Viewport.Width - btnWidth - 20,
                                              GraphicsDevice.Viewport.Height - btnHeight - 20,
                                              btnWidth, btnHeight);
                Color btnColor = endTurnHovered ? Color.DarkRed : Color.Red;
                _spriteBatch.Draw(pixel, endTurnButton, btnColor);
                Vector2 txtSize = font.MeasureString("FIN DU TOUR");
                _spriteBatch.DrawString(font, "FIN DU TOUR",
                    new Vector2(endTurnButton.X + (btnWidth - txtSize.X) / 2,
                                endTurnButton.Y + (btnHeight - txtSize.Y) / 2),
                    Color.White);

                DrawUnitInfoPanel(); // panneau d'info de l'unité sélectionnée

                // --- Gestion des fire targets ---
                if (showFireTargets && selectedUnit != null && selectedUnit.Team == Team.Player)
                {
                    MouseState mouse = Mouse.GetState();
                    hoveredFireTarget = null;

                    // détecte le survol d'une icône de cible
                    foreach (var ui in fireTargetsUI)
                    {
                        if (ui.Bounds.Contains(mouse.Position))
                        {
                            hoveredFireTarget = ui.Target;
                            break;
                        }
                    }

                    // dessine toutes les icônes de fire target
                    foreach (var ui in fireTargetsUI)
                    {
                        Color bg = ui.Target == selectedFireTarget ? Color.OrangeRed : Color.DarkRed;
                        _spriteBatch.Draw(pixel, ui.Bounds, bg);

                        string txt = ui.HitChance + "%";
                        Vector2 size = font.MeasureString(txt);
                        _spriteBatch.DrawString(font, txt,
                            new Vector2(ui.Bounds.Center.X - size.X / 2, ui.Bounds.Center.Y - size.Y / 2),
                            Color.White);
                    }

                    // contour autour de l'unité ciblée ou survolée
                    Unit targetToHighlight = selectedFireTarget ?? hoveredFireTarget;
                    if (targetToHighlight != null)
                    {
                        var ui = fireTargetsUI.FirstOrDefault(f => f.Target == targetToHighlight);
                        if (ui != null)
                        {
                            Rectangle targetRect = ui.Bounds;

                            _spriteBatch.Draw(pixel, targetRect, Color.Red * 0.4f); // semi-transparent
                            int thickness = 3;
                            DrawLine(_spriteBatch, new Vector2(targetRect.Left, targetRect.Top),
                                                new Vector2(targetRect.Right, targetRect.Top), Color.Red, thickness);
                            DrawLine(_spriteBatch, new Vector2(targetRect.Left, targetRect.Bottom),
                                                new Vector2(targetRect.Right, targetRect.Bottom), Color.Red, thickness);
                            DrawLine(_spriteBatch, new Vector2(targetRect.Left, targetRect.Top),
                                                new Vector2(targetRect.Left, targetRect.Bottom), Color.Red, thickness);
                            DrawLine(_spriteBatch, new Vector2(targetRect.Right, targetRect.Top),
                                                new Vector2(targetRect.Right, targetRect.Bottom), Color.Red, thickness);
                        }
                    }
                }
            }

            // --- 4c. Menu Options ---
            else if (currentState == GameState.OptionsMenu)
            {
                string title = "Options";
                _spriteBatch.DrawString(font, title, Vector2.Zero, Color.White, 0f, Vector2.Zero, 3f, SpriteEffects.None, 0f);
                MouseState mouse = Mouse.GetState();
                foreach (var button in optionsButtons) button.Draw(_spriteBatch, font, mouse);

                // barre de volume
                _spriteBatch.Draw(pixel, volumeBar, Color.Gray);
                _spriteBatch.Draw(pixel, volumeFill, Color.Yellow);
                _spriteBatch.Draw(pixel, volumeHandle, Color.White);
            }

            _spriteBatch.End(); // fin du batch UI
            base.Draw(gameTime);
        }


        // Initialise les paramètres de la carte tactique
        // (taille de la grille, taille des cellules, obstacles)
        private void LoadMap()
        {
            // Nombre de colonnes de la grille
            // → largeur totale = gridWidth * cellSize
            gridWidth = 20;

            // Nombre de lignes de la grille
            // → hauteur totale = gridHeight * cellSize
            gridHeight = 15;

            // Taille d’une cellule en pixels (largeur et hauteur)
            // Sert à convertir :
            // - cellule → position monde
            // - position souris → cellule
            cellSize = 32;

            // Génère des obstacles aléatoires sur la carte
            // Le paramètre (30) correspond au nombre total d’obstacles
            // Ces obstacles bloquent le déplacement et la ligne de vue
            GenerateObstacles(30);

            // Message de debug pour confirmer le chargement de la carte
            Console.WriteLine("Map loaded");
        }


        // Dessine la carte tactique :
        // 1) les tuiles de sol
        // 2) les obstacles
        // 3) la grille par-dessus (overlay)
        private void DrawGrid()
        {
            // --- 1️⃣ Dessin des tuiles de sol ---
            // Parcours de toutes les cellules de la grille
            for (int x = 0; x < gridWidth; x++)
            {
                for (int y = 0; y < gridHeight; y++)
                {
                    // Rectangle écran correspondant à la cellule (x, y)
                    Rectangle rect = new Rectangle(
                        x * cellSize,
                        y * cellSize,
                        cellSize,
                        cellSize
                    );

                    // Dessin de la texture de sol
                    _spriteBatch.Draw(tileTexture, rect, Color.White);
                }
            }

            // --- 2️⃣ Dessin des obstacles ---
            // Chaque obstacle est stocké comme une cellule bloquée
            foreach (var cell in obstacles)
            {
                // Conversion cellule → rectangle écran
                Rectangle rect = new Rectangle(
                    cell.X * cellSize,
                    cell.Y * cellSize,
                    cellSize,
                    cellSize
                );

                // Dessin de la texture d’obstacle
                _spriteBatch.Draw(obstacleTexture, rect, Color.White);
            }

            // --- 3️⃣ Dessin de la grille (overlay) ---
            // Couleur blanche semi-transparente pour ne pas masquer le sol
            Color gridColor = new Color(255, 255, 255, 80);

            // Lignes verticales de la grille
            // x <= gridWidth → inclut la dernière ligne de bord
            for (int x = 0; x <= gridWidth; x++)
            {
                _spriteBatch.Draw(
                    pixel, // texture 1x1 blanche étirée
                    new Rectangle(
                        x * cellSize,        // position X de la ligne
                        0,                   // en haut de la carte
                        1,                   // épaisseur de la ligne
                        gridHeight * cellSize // hauteur totale de la grille
                    ),
                    gridColor
                );
            }

            // Lignes horizontales de la grille
            // y <= gridHeight → inclut la dernière ligne de bord
            for (int y = 0; y <= gridHeight; y++)
            {
                _spriteBatch.Draw(
                    pixel, // texture 1x1 blanche étirée
                    new Rectangle(
                        0,                    // à gauche de la carte
                        y * cellSize,         // position Y de la ligne
                        gridWidth * cellSize, // largeur totale de la grille
                        1                     // épaisseur de la ligne
                    ),
                    gridColor
                );
            }
        }


        // Dessine une ligne entre deux points écran en utilisant une texture 1x1
        // La ligne est étirée, tournée et colorée dynamiquement
        private void DrawLine(SpriteBatch sb, Vector2 start, Vector2 end, Color color, float thickness)
        {
            // Vecteur direction allant du point de départ au point d’arrivée
            Vector2 delta = end - start;

            // Longueur réelle de la ligne (norme du vecteur)
            float length = delta.Length();

            // Angle de rotation de la ligne en radians
            // Atan2 donne l’angle correct quel que soit le quadrant
            float rotation = (float)Math.Atan2(delta.Y, delta.X);

            // Dessin de la ligne à partir d’une texture 1x1 (pixel)
            sb.Draw(
                pixel,              // Texture de base (1x1 blanc)
                start,              // Position de départ de la ligne
                null,               // On utilise toute la texture
                color,              // Couleur finale de la ligne
                rotation,           // Rotation pour orienter la ligne
                Vector2.Zero,       // Origine au coin haut-gauche de la texture
                new Vector2(
                    length,         // Étirement horizontal = longueur de la ligne
                    thickness       // Étirement vertical = épaisseur de la ligne
                ),
                SpriteEffects.None, // Aucun effet miroir
                0f                  // LayerDepth (ordre de rendu)
            );
        }


        // Dessine une flèche entre deux points écran
        // Utilise DrawLine pour tracer le corps et la pointe de la flèche
        private void DrawArrow(SpriteBatch sb, Vector2 from, Vector2 to, Color color)
        {
            // Épaisseur du corps de la flèche (en pixels)
            float thickness = 3f;

            // Longueur de chaque segment de la pointe de la flèche
            float headLength = 12f;

            // Angle d’ouverture de la pointe (30° de chaque côté)
            float headAngle = MathHelper.ToRadians(30f);

            // --- 1️⃣ Dessin du corps de la flèche ---
            DrawLine(sb, from, to, color, thickness);

            // --- 2️⃣ Calcul de la direction de la flèche ---
            // Direction normalisée allant de la pointe vers la base
            // (on part de to pour revenir vers from)
            Vector2 dir = Vector2.Normalize(from - to);

            // Angle global de la flèche en radians
            float angle = (float)Math.Atan2(dir.Y, dir.X);

            // --- 3️⃣ Calcul du segment gauche de la pointe ---
            Vector2 left = to + new Vector2(
                (float)Math.Cos(angle + headAngle),
                (float)Math.Sin(angle + headAngle)
            ) * headLength;

            // --- 4️⃣ Calcul du segment droit de la pointe ---
            Vector2 right = to + new Vector2(
                (float)Math.Cos(angle - headAngle),
                (float)Math.Sin(angle - headAngle)
            ) * headLength;

            // --- 5️⃣ Dessin de la pointe de la flèche ---
            DrawLine(sb, to, left, color, thickness);
            DrawLine(sb, to, right, color, thickness);
        }


        // Dessine la cellule actuellement survolée par la souris avec un effet de pulsation
        private void DrawHoveredCell(GameTime gameTime)
        {
            // --- 1️⃣ Vérification que la cellule survolée est valide ---
            // Si la souris est hors de la grille, on ne fait rien
            if (hoveredCell.X < 0 || hoveredCell.Y < 0)
                return;

            // --- 2️⃣ Calcul du rectangle écran correspondant à la cellule ---
            Rectangle cellRect = new Rectangle(
                hoveredCell.X * cellSize,  // position X de la cellule en pixels
                hoveredCell.Y * cellSize,  // position Y de la cellule en pixels
                cellSize,                  // largeur de la cellule
                cellSize                   // hauteur de la cellule
            );

            // --- 3️⃣ Calcul de la pulsation pour un effet visuel dynamique ---
            // gameTime.TotalGameTime.TotalSeconds -> temps total écoulé
            // Sinus pour créer un mouvement oscillant
            float pulse = (float)Math.Sin(gameTime.TotalGameTime.TotalSeconds * 6f);
            // Alpha final oscillant entre 0.2 et 0.6
            float alpha = 0.4f + pulse * 0.2f;
            Color fillColor = Color.Yellow * alpha;           // couleur de remplissage pulsante
            Color outlineColor = Color.Yellow * (alpha + 0.2f); // contour légèrement plus opaque

            // --- 4️⃣ Remplissage léger de la cellule ---
            // Utilise le pixel blanc pour dessiner un rectangle plein semi-transparent
            _spriteBatch.Draw(pixel, cellRect, Color.Yellow * 0.25f);

            int thickness = 2; // épaisseur des lignes du contour

            // --- 5️⃣ Dessin du contour de la cellule ---
            // Ligne du haut
            DrawLine(_spriteBatch,
                new Vector2(cellRect.Left, cellRect.Top),
                new Vector2(cellRect.Right, cellRect.Top),
                Color.Yellow, thickness);

            // Ligne du bas
            DrawLine(_spriteBatch,
                new Vector2(cellRect.Left, cellRect.Bottom),
                new Vector2(cellRect.Right, cellRect.Bottom),
                Color.Yellow, thickness);

            // Ligne de gauche
            DrawLine(_spriteBatch,
                new Vector2(cellRect.Left, cellRect.Top),
                new Vector2(cellRect.Left, cellRect.Bottom),
                Color.Yellow, thickness);

            // Ligne de droite
            DrawLine(_spriteBatch,
                new Vector2(cellRect.Right, cellRect.Top),
                new Vector2(cellRect.Right, cellRect.Bottom),
                Color.Yellow, thickness);
        }


        // Initialise et crée les unités pour les deux équipes : joueur et ennemis
        private void CreateUnits()
        {
            // --- 1️⃣ Vider les listes existantes ---
            // On supprime toutes les unités précédemment créées pour repartir à zéro
            playerUnits.Clear();
            enemyUnits.Clear();

            // --- 2️⃣ Création des unités du joueur ---
            for (int i = 0; i < 6; i++) // 6 unités
            {
                // Chaque unité est placée sur la deuxième ligne depuis le bas : Y = gridHeight - 2
                // X = 2 + i → positions espacées horizontalement
                playerUnits.Add(
                    new Unit(
                        new Point(2 + i, gridHeight - 2), // position dans la grille
                        Team.Player,                      // équipe du joueur
                        "Soldier " + (i + 1),             // nom unique "Soldier 1", "Soldier 2", etc.
                        "Assault",                         // classe de l’unité
                        "Rifle",                           // arme de base
                        weaponDatabase["Rifle"]            // données de l’arme depuis la base de données
                    )
                );
            }

            // --- 3️⃣ Création des unités ennemies ---
            for (int i = 0; i < 6; i++) // 6 unités ennemies
            {
                // On choisit un modèle d’ennemi au hasard dans la liste enemyPool
                EnemyTemplate template =
                    enemyPool[random.Next(enemyPool.Count)];

                // Création de l’unité ennemie
                enemyUnits.Add(
                    new Unit(
                        new Point(2 + i, 1),            // position sur la deuxième ligne depuis le haut
                        Team.Enemy,                      // équipe ennemie
                        template.Name,                   // nom selon le template choisi
                        template.Class,                  // classe selon le template
                        template.Weapon,                 // arme selon le template
                        weaponDatabase[template.Weapon]  // données de l’arme depuis la base de données
                    )
                    {
                        ActionPoints = template.ActionPoints // personnalisation des points d'action
                    }
                );
            }

            // --- 4️⃣ Affichage console pour débogage ---
            Console.WriteLine("Units created: 6 player, 6 enemy");
        }


        // Dessine toutes les unités présentes sur la grille
        private void DrawUnits()
        {
            // --- 1️⃣ Dessiner les unités du joueur ---
            foreach (var unit in playerUnits)  // pour chaque unité dans la liste playerUnits
                DrawUnit(unit);                // on appelle la méthode DrawUnit qui s’occupe du rendu

            // --- 2️⃣ Dessiner les unités ennemies ---
            foreach (var unit in enemyUnits)   // pour chaque unité dans la liste enemyUnits
                DrawUnit(unit);                // même principe : DrawUnit gère le rendu
