        private void DrawGrid()
        {
            for (int x = 0; x < gridWidth; x++)
            {
                for (int y = 0; y < gridHeight; y++)
                {
                    Rectangle rect = new Rectangle(x * cellSize, y * cellSize, cellSize, cellSize);
                    _spriteBatch.Draw(tileTexture, rect, Color.White);
                }
            }
            foreach (var cell in obstacles)
            {
                Rectangle rect = new Rectangle(
                    cell.X * cellSize,
                    cell.Y * cellSize,
                    cellSize,
                    cellSize
                );
                _spriteBatch.Draw(pixel, rect, Color.DarkSlateGray);
            }
            Color gridColor = new Color(255, 255, 255, 80);
            for (int x = 0; x <= gridWidth; x++)
            {
                _spriteBatch.Draw(
                    pixel,
                    new Rectangle(
                        x * cellSize,
                        0,
                        1,
                        gridHeight * cellSize),
                    gridColor);
            }
            for (int y = 0; y <= gridHeight; y++)
            {
                _spriteBatch.Draw(
                    pixel,
                    new Rectangle(
                        0,
                        y * cellSize,
                        gridWidth * cellSize,
                        1),
                    gridColor);
            }
        }
        private void DrawLine(SpriteBatch sb, Vector2 start, Vector2 end, Color color, float thickness)
        {
            Vector2 delta = end - start;
            float length = delta.Length();
            float rotation = (float)Math.Atan2(delta.Y, delta.X);
            sb.Draw(
                pixel,
                start,
                null,
                color,
                rotation,
                Vector2.Zero,
                new Vector2(length, thickness),
                SpriteEffects.None,
                0f
            );
        }
        private void DrawArrow(SpriteBatch sb, Vector2 from, Vector2 to, Color color)
        {
            float thickness = 3f;
            float headLength = 12f;
            float headAngle = MathHelper.ToRadians(30f);
            DrawLine(sb, from, to, color, thickness);
            Vector2 dir = Vector2.Normalize(from - to);
            float angle = (float)Math.Atan2(dir.Y, dir.X);
            Vector2 left = to + new Vector2(
                (float)Math.Cos(angle + headAngle),
                (float)Math.Sin(angle + headAngle)
            ) * headLength;
            Vector2 right = to + new Vector2(
                (float)Math.Cos(angle - headAngle),
                (float)Math.Sin(angle - headAngle)
            ) * headLength;
            DrawLine(sb, to, left, color, thickness);
            DrawLine(sb, to, right, color, thickness);
        }
        private void DrawHoveredCell()
        {
            if (hoveredCell.X < 0 || hoveredCell.Y < 0)
                return;
            Rectangle cellRect = new Rectangle(
                hoveredCell.X * cellSize,
                hoveredCell.Y * cellSize,
                cellSize,
                cellSize);
            Color highlightColor = new Color(255, 255, 0, 80);
            _spriteBatch.Draw(pixel, cellRect, highlightColor);
        }
        private void CreateUnits()
        {
            playerUnits.Clear();
            enemyUnits.Clear();
            for (int i = 0; i < 6; i++)
            {
                playerUnits.Add(
                    new Unit(
                        new Point(2 + i, gridHeight - 2),
                        Team.Player,
                        "Soldier " + (i + 1),
                        "Assault",
                        "Rifle",
                        weaponDatabase["Rifle"]
                    )
                );
            }
            for (int i = 0; i < 6; i++)
            {
                EnemyTemplate template =
                    enemyPool[random.Next(enemyPool.Count)];
                enemyUnits.Add(
                    new Unit(
                        new Point(2 + i, 1),
                        Team.Enemy,
                        template.Name,
                        template.Class,
                        template.Weapon,
                        weaponDatabase[template.Weapon]
                    )
                    {
                        ActionPoints = template.ActionPoints
                    }
                );
            }
            Console.WriteLine("Units created: 6 player, 6 enemy");
        }
        private void DrawUnits()
        {
            foreach (var unit in playerUnits)
                DrawUnit(unit);
            foreach (var unit in enemyUnits)
                DrawUnit(unit);
        }
        private void DrawUnit(Unit unit)
        {
            Rectangle rect = new Rectangle(
                unit.Cell.X * cellSize + 4,
                unit.Cell.Y * cellSize + 4,
                cellSize - 8,
                cellSize - 8
            );
            Color color = (unit.Team == Team.Player)
                ? Color.Blue
                : Color.Red;
            _spriteBatch.Draw(pixel, rect, color);
            if (unit.IsFiring && unit.FireTarget.HasValue)
            {
                Point target = unit.FireTarget.Value;
                Vector2 start = new Vector2(unit.Cell.X + 0.5f, unit.Cell.Y + 0.5f) * cellSize;
                Vector2 end = new Vector2(target.X + 0.5f, target.Y + 0.5f) * cellSize;
                Vector2 pos = Vector2.Lerp(start, end, unit.FireProgress);
                Rectangle proj = new Rectangle((int)pos.X - 4, (int)pos.Y - 4, 8, 8);
                _spriteBatch.Draw(pixel, proj, Color.Yellow);
            }
            if (unit == selectedUnit)
            {
                Rectangle outline = new Rectangle(
                    unit.Cell.X * cellSize,
                    unit.Cell.Y * cellSize,
                    cellSize,
                    cellSize
                );
                _spriteBatch.Draw(pixel, outline, new Color(0, 255, 255, 80));
            }
        }
        private IEnumerable<Unit> AllUnits()
        {
            foreach (var u in playerUnits) yield return u;
            foreach (var u in enemyUnits) yield return u;
        }
