        private void HandlePlayerTurn(MouseState mouse, bool leftClick)
        {
            // 1️⃣ Souris → coordonnées monde → cellule
            Vector2 mouseWorld = (new Vector2(mouse.X, mouse.Y) - new Vector2(GraphicsDevice.Viewport.Width / 2, GraphicsDevice.Viewport.Height / 2)) / zoom + cameraOffset;
            int cellX = (int)(mouseWorld.X / cellSize), cellY = (int)(mouseWorld.Y / cellSize);
            hoveredCell = (cellX >= 0 && cellX < gridWidth && cellY >= 0 && cellY < gridHeight) ? new Point(cellX, cellY) : new Point(-1, -1);
            if (selectedUnit != null && fireButton.Contains(mouse.Position)) hoveredCell = new Point(-1, -1);

            // 2️⃣ Calcul du chemin A* en temps réel au survol
            currentPath.Clear();
            pathCosts.Clear();
            showMoveArrow = false;

            if (selectedUnit != null && selectedUnit.ActionPoints > 0 && hoveredCell.X != -1 &&
                cachedMovableCells.Contains(hoveredCell) && selectedUnit.Team == Team.Player)
            {
                // Calcule le chemin avec A*
                currentPath = FindPathAStar(selectedUnit.Cell, hoveredCell, selectedUnit.MovementPoints);

                // Calcule les coûts cumulés pour chaque case du chemin
                pathCosts.Clear();
                for (int i = 0; i < currentPath.Count; i++)
                {
                    pathCosts[currentPath[i]] = i + 1;
                }

                // Affiche aussi la flèche
                if (currentPath.Count > 0)
                {
                    arrowFromCell = selectedUnit.Cell;
                    arrowToCell = hoveredCell;
                    showMoveArrow = true;
                }
            }

            // 3️⃣ Détection clic sur UI
            bool clickOnUI = fireButton.Contains(mouse.Position) || IsMouseOverActionButton(mouse);

            // 4️⃣ Clic gauche sur la grille
            if (leftClick && !clickOnUI) HandleGridClick(new Point(cellX, cellY));

            // 5️⃣ Boutons d'action
            if (leftClick) HandleUnitActionButtons(mouse);

            // 6️⃣ Sélection cible tir
            if (leftClick && showFireTargets)
                foreach (var ui in fireTargetsUI)
                    if (ui.Bounds.Contains(mouse.Position)) { selectedFireTarget = ui.Target; break; }

            // 7️⃣ Clic droit : annulation
            if (mouse.RightButton == ButtonState.Pressed && previousMouseState.RightButton == ButtonState.Released)
                CancelSelection();

            // 8️⃣ Bouton "Tirer"
            fireButtonHovered = fireButton.Contains(mouse.Position);
            if (fireButtonHovered && leftClick && selectedUnit != null && selectedFireTarget != null && selectedUnit.ActionPoints > 0)
            {
                FireAtTarget(selectedUnit, selectedFireTarget);
                UpdateFireTargets();
            }

            // 9️⃣ Bouton "Fin de tour"
            endTurnHovered = endTurnButton.Contains(mouse.Position);
            if (endTurnHovered && leftClick && !isActionInProgress) StartEnemyTurn();
        }

        private void HandleGridClick(Point clickedCell)
        {
            Unit clickedUnit = GetUnitAtCell(clickedCell);

            if (clickedUnit != null)
            {
                selectedUnit = clickedUnit;
                if (selectedUnit.Team == Team.Player)
                {
                    cachedMovableCells = GetMovableCells(selectedUnit);
                    UpdateFireTargets();
                }
                else
                {
                    cachedMovableCells.Clear();
                    showMoveArrow = false;
                    currentPath.Clear();
                    pathCosts.Clear();
                }
            }
            else if (selectedUnit != null && selectedUnit.ActionPoints > 0)
            {
                var movable = GetMovableCells(selectedUnit);
                if (movable.Contains(clickedCell))
                {
                    // Utilise A* pour calculer le vrai coût de déplacement
                    var path = FindPathAStar(selectedUnit.Cell, clickedCell, selectedUnit.MovementPoints);

                    if (path.Count > 0 && path.Count <= selectedUnit.MovementPoints)
                    {
                        selectedUnit.Cell = clickedCell;
                        selectedUnit.ActionPoints--;
                        UpdateFireTargets();
                        cachedMovableCells = selectedUnit.ActionPoints > 0 ? GetMovableCells(selectedUnit) : new List<Point>();
                        currentPath.Clear();
                        pathCosts.Clear();
                    }
                }
            }
        }

