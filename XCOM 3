        protected override void Update(GameTime gameTime)
        {
            MouseState mouse = Mouse.GetState();
            KeyboardState keyboard = Keyboard.GetState();
            bool leftClick = mouse.LeftButton == ButtonState.Pressed &&
                             previousMouseState.LeftButton == ButtonState.Released;
            bool escapePressed = keyboard.IsKeyDown(Keys.Escape) &&
                                 previousKeyboardState.IsKeyUp(Keys.Escape);

            // --- Bouton "Continue" actif seulement si une partie sauvegardée existe ---
            menuButtons[1].IsEnabled = hasSavedGame;

            switch (currentState)
            {
                case GameState.MainMenu:
                    HandleMainMenu(mouse);
                    break;

                case GameState.Playing:
                    // Tour du joueur ou de l'ennemi
                    if (currentTurn == TurnState.PlayerTurn) HandlePlayerTurn(mouse, leftClick);
                    else if (currentTurn == TurnState.EnemyTurn) UpdateEnemyTurn();

                    // Gestion du jeu
                    HandleZoom();
                    HandleCameraMovement(gameTime, mouse);
                    UpdateFiringAnimations(gameTime);

                    // ESCAPE : sauvegarde et retour au menu
                    if (escapePressed)
                    {
                        hasSavedGame = true;

                        savedPlayerUnits = playerUnits.Select(u => new Unit(u)).ToList();
                        savedEnemyUnits = enemyUnits.Select(u => new Unit(u)).ToList();

                        currentState = GameState.MainMenu;
                    }
                    break;

                case GameState.OptionsMenu:
                    HandleOptionsMenu(mouse);

                    if (escapePressed)
                        currentState = GameState.MainMenu; // Retour au menu sans sauvegarde
                    break;
            }

            // Sauvegarde des états pour le prochain frame
            previousMouseState = mouse;
            previousKeyboardState = keyboard;

            base.Update(gameTime);
        }

        protected override void Draw(GameTime gameTime)
        {
            GraphicsDevice.Clear(Color.Black);

            // --- Transformation caméra ---
            Matrix transform = Matrix.CreateTranslation(new Vector3(-cameraOffset, 0)) *
                               Matrix.CreateScale(zoom, zoom, 1) *
                               Matrix.CreateTranslation(new Vector3(GraphicsDevice.Viewport.Width / 2,
                                                                    GraphicsDevice.Viewport.Height / 2, 0));

            // --- Dessin du monde (grille, unités, flèches) ---
            if (currentState == GameState.Playing)
            {
                _spriteBatch.Begin(transformMatrix: transform);
                DrawGrid();
                DrawUnits();
                DrawHoveredCell(gameTime);

                // Affichage des cellules accessibles
                if (selectedUnit != null && selectedUnit.ActionPoints > 0 && currentTurn == TurnState.PlayerTurn &&
                    selectedUnit.Team == Team.Player)
                {
                    foreach (var cell in cachedMovableCells)
                    {
                        _spriteBatch.Draw(pixel, new Rectangle(cell.X * cellSize, cell.Y * cellSize, cellSize, cellSize),
                                          new Color(0, 255, 0, 80));
                    }
                }

                // Affichage du chemin A*
                if (currentPath.Count > 0 && selectedUnit != null && selectedUnit.Team == Team.Player)
                {
                    DrawPath(gameTime);
                }

                if (showMoveArrow && selectedUnit != null && selectedUnit.Team == Team.Player)
                {
                    Vector2 from = new(arrowFromCell.X * cellSize + cellSize / 2, arrowFromCell.Y * cellSize + cellSize / 2);
                    Vector2 to = new(arrowToCell.X * cellSize + cellSize / 2, arrowToCell.Y * cellSize + cellSize / 2);
                    float pulse = (float)Math.Sin(gameTime.TotalGameTime.TotalSeconds * 6f) * 0.2f;
                    DrawArrow(_spriteBatch, from, to, Color.CornflowerBlue * (0.7f + pulse * 0.3f));
                }

                _spriteBatch.End();
            }

            // --- UI (sans transformation) ---
            _spriteBatch.Begin();
            switch (currentState)
            {
                case GameState.MainMenu:
                    _spriteBatch.DrawString(font, "XCOM 3", Vector2.Zero, Color.White, 0f, Vector2.Zero, 3f, SpriteEffects.None, 0f);
                    MouseState mouse = Mouse.GetState();
                    foreach (var button in menuButtons) button.Draw(_spriteBatch, font, mouse);
                    break;

                case GameState.Playing:
                    DrawEndTurnButton();
                    DrawUnitInfoPanel();
                    if (showFireTargets && selectedUnit != null && selectedUnit.Team == Team.Player)
                        DrawFireTargets();
                    break;

                case GameState.OptionsMenu:
                    _spriteBatch.DrawString(font, "Options", Vector2.Zero, Color.White, 0f, Vector2.Zero, 3f, SpriteEffects.None, 0f);
                    mouse = Mouse.GetState();
                    foreach (var button in optionsButtons) button.Draw(_spriteBatch, font, mouse);
                    _spriteBatch.Draw(pixel, volumeBar, Color.Gray);
                    _spriteBatch.Draw(pixel, volumeFill, Color.Yellow);
                    _spriteBatch.Draw(pixel, volumeHandle, Color.White);
                    break;
            }
            _spriteBatch.End();

            base.Draw(gameTime);
        }

