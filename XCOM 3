        // Logique du jeu (appelé à chaque frame)
        protected override void Update(GameTime gameTime) // Classe héritée de Game
        {
            // État actuel de la souris
            MouseState mouse = Mouse.GetState();

            // Si on est dans le Main Menu
            if (currentState == GameState.MainMenu)
            {
                // Vérifie les clics sur chaque bouton
                foreach (var button in menuButtons)
                {
                    // Si le bouton de la souris est cliqué
                    if (button.IsClicked(mouse, previousMouseState))
                    {
                        // Action selon le texte du bouton
                        switch (button.Text)
                        {
                            case "New Game":
                                //MediaPlayer.Stop(); // Stop la musique
                                currentState = GameState.Playing; // Passe en mode jeu
                                LoadMap();                                
                                CreateUnits(); // Créer les unités au lancement de New Game - 1.5.0                          
                                Console.WriteLine("New game launched !");
                                break;

                            case "Continue":
                                Console.WriteLine("Continue a saved game...");
                                break;

                            case "Encylopedia":
                                Console.WriteLine("Open encyclopedia...");
                                break;

                            case "Options":
                                currentState = GameState.OptionsMenu;
                                Console.WriteLine("Options");
                                break;

                            case "Quit":
                                Exit(); // Quitte le jeu
                                break;
                        }
                    }
                }
            }

            // Si on est dans New Game
            if (currentState == GameState.Playing)
            {
                int mouseX = mouse.X;
                int mouseY = mouse.Y;

                int cellX = mouseX / cellSize;
                int cellY = mouseY / cellSize;

                // Vérifie que la souris est dans la grille
                if (cellX >= 0 && cellX < gridWidth &&
                    cellY >= 0 && cellY < gridHeight)
                {
                    hoveredCell = new Point(cellX, cellY);
                }
                else
                {
                    hoveredCell = new Point(-1, -1);
                }

                if (currentState == GameState.Playing) // 1.5.1
                    // Clic gauche unique
                    if (mouse.LeftButton == ButtonState.Pressed &&
                        previousMouseState.LeftButton == ButtonState.Released)
                    {
                        // Calcul direct de la cellule cliquée
                        // int cellX = mouse.X / cellSize; // Déjà mentionné plus haut.
                        // int cellY = mouse.Y / cellSize; // 

                        Point clickedCell = new Point(cellX, cellY);

                        // Vérifie que le clic est dans la grille
                        if (cellX >= 0 && cellX < gridWidth &&
                            cellY >= 0 && cellY < gridHeight)
                        {
                            Unit clickedUnit = GetUnitAtCell(clickedCell);

                            // On ne change la sélection QUE si une unité est cliquée
                            if (clickedUnit != null)
                            {
                                selectedUnit = clickedUnit;

                            }
                        }
                    }
                if (mouse.RightButton == ButtonState.Pressed &&
                    previousMouseState.RightButton == ButtonState.Released)
                {
                    selectedUnit = null;
                }
                if (selectedUnit != null && mouse.LeftButton == ButtonState.Pressed &&
                    previousMouseState.LeftButton == ButtonState.Released)
                {
                    // int cellX = mouse.X / cellSize;
                    // int cellY = mouse.Y / cellSize;
                    Point clickedCell = new Point(cellX, cellY);

                    var movableCells = GetMovableCells(selectedUnit);

                    if (movableCells.Contains(clickedCell))
                    {
                        selectedUnit.Cell = clickedCell;
                        // On peut réduire les PA si tu veux un vrai système tour par tour
                    }
                }

                // Attaque avec clic droit - 1.5.4
                if (selectedUnit != null &&
                    mouse.RightButton == ButtonState.Pressed &&
                    previousMouseState.RightButton == ButtonState.Released)
                {
                    Unit enemy = GetAdjacentEnemy(selectedUnit);

                    if (enemy != null)
                    {
                        // Calcul simple : chance de toucher 80%
                        if (random.NextDouble() < 0.8)
                        {
                            enemy.HP -= selectedUnit.Damage;
                            if (enemy.HP < 0) enemy.HP = 0;
                            Console.WriteLine($"{selectedUnit.Name} hits {enemy.Name} for {selectedUnit.Damage} damage!");
                        }
                        else
                        {
                            Console.WriteLine($"{selectedUnit.Name} missed {enemy.Name}!");
                        }
                    }
                }
            }

            // Détecter les clics dans le Menu Options // 1.4.0
            if (currentState == GameState.OptionsMenu)
            {
                foreach (var button in optionsButtons)
                {
                    if (button.IsClicked(mouse, previousMouseState))
                    {
                        switch (button.Text)
                        {
                            case "Music Volume +":
                                musicVolume += 0.1f;
                                if (musicVolume > 1f) musicVolume = 1f;
                                MediaPlayer.Volume = musicVolume;
                                Console.WriteLine("Volume: " + musicVolume);
                                break;

                            case "Music Volume -":
                                musicVolume -= 0.1f;
                                if (musicVolume < 0f) musicVolume = 0f;
                                MediaPlayer.Volume = musicVolume;
                                Console.WriteLine("Volume: " + musicVolume);
                                break;

                            case "Back":
                                currentState = GameState.MainMenu;
                                break;
                        }
                    }
                }

                // Logique du slider(Update – OptionsMenu) 1.4.1
                // Détection clic / drag
                if (mouse.LeftButton == ButtonState.Pressed &&
                    volumeBar.Contains(mouse.Position))
                {
                    draggingVolume = true;
                }

                if (mouse.LeftButton == ButtonState.Released)
                {
                    draggingVolume = false;
                }

                if (draggingVolume)
                {
                    float percent =
                        (mouse.X - volumeBar.X) / (float)volumeBar.Width;

                    musicVolume = MathHelper.Clamp(percent, 0f, 1f);
                    MediaPlayer.Volume = musicVolume;
                }

                // Mise à jour des rectangles visuels
                volumeFill = new Rectangle(
                    volumeBar.X,
                    volumeBar.Y,
                    (int)(volumeBar.Width * musicVolume),
                    volumeBar.Height);

                int handleX = volumeBar.X + volumeFill.Width - 5;

                volumeHandle = new Rectangle(
                    handleX,
                    volumeBar.Y - 4,
                    10,
                    volumeBar.Height + 8);
            }


            // Sauvegarde l’état actuel pour la frame suivante
            previousMouseState = mouse;

            // Quitte le jeu si ESC est appuyé
            if (Keyboard.GetState().IsKeyDown(Keys.Escape))
                Exit();

            base.Update(gameTime);


        }



