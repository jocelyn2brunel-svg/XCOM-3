        private void HandleZoom()
        {
            // Récupère l'état actuel de la souris
            MouseState mouseState = Mouse.GetState();

            // Valeur totale de la molette depuis le lancement du programme
            float scroll = mouseState.ScrollWheelValue;

            // Calcul du delta depuis la dernière frame
            // 120 correspond à un "tick" standard de molette (1 cran = 120)
            float scrollDelta = (scroll - previousScroll) / 120f;

            // Sauvegarde la position actuelle de la molette pour le prochain update
            previousScroll = scroll;

            // Si la molette a été déplacée
            if (scrollDelta != 0)
            {
                // Ajuste le facteur de zoom
                // 0.1f = vitesse de zoom (chaque cran = +10% du zoom)
                zoom += scrollDelta * 0.1f;

                // Limite le zoom pour qu'il reste entre minZoom et maxZoom
                zoom = MathHelper.Clamp(zoom, minZoom, maxZoom);
            }
        }

        private void HandleCameraMovement(GameTime gameTime, MouseState mouse)
        {
            // Récupère l'état actuel du clavier
            KeyboardState keyboardState = Keyboard.GetState();

            // --- Déplacement de la caméra avec WASD ---
            Vector2 move = Vector2.Zero; // vecteur de déplacement initialisé à 0

            // Ajuste le vecteur selon les touches enfoncées
            if (keyboardState.IsKeyDown(Keys.W)) move.Y -= 1; // haut
            if (keyboardState.IsKeyDown(Keys.S)) move.Y += 1; // bas
            if (keyboardState.IsKeyDown(Keys.A)) move.X -= 1; // gauche
            if (keyboardState.IsKeyDown(Keys.D)) move.X += 1; // droite

            // Normalise le vecteur pour éviter que la diagonale soit plus rapide que les axes seuls
            if (move != Vector2.Zero) move.Normalize();

            // Applique le déplacement à la caméra
            // Multiplication par la vitesse de la caméra et le temps écoulé pour un mouvement fluide et indépendant du FPS
            cameraOffset += move * cameraSpeed * (float)gameTime.ElapsedGameTime.TotalSeconds;

            // --- Déplacement de la caméra avec le clic du milieu de la souris ---
            // Si le bouton du milieu est enfoncé
            if (mouse.MiddleButton == ButtonState.Pressed)
            {
                // Calcul de la différence de mouvement de la souris depuis le dernier frame
                Vector2 mouseDelta = new Vector2(mouse.X - previousMouseState.X, mouse.Y - previousMouseState.Y);

                // Déplace la caméra dans le sens inverse du mouvement de la souris
                // Divisé par le zoom pour que le déplacement reste proportionnel à l'affichage
                cameraOffset -= mouseDelta / zoom;
            }
        }
    }


    // Représente un bouton UI simple basé sur du texte
    // Utilisé pour les actions d’unité (TIRER, COUVERT, etc.)
    public class Button
    {
        // Texte affiché sur le bouton
        public string Text;

        // Position du bouton à l’écran (coordonnées écran, pas monde)
        public Vector2 Position;

        // Largeur et hauteur "logiques" du bouton
        // ⚠️ Actuellement NON utilisées pour le rendu ou le clic
        public int Width = 100;
        public int Height = 36;

        // Rectangle cliquable réel du bouton
        // Mis à jour dans Draw() à partir du texte mesuré
        private Rectangle bounds;

        // Indique si le bouton est interactif
        // false → grisé et non cliquable
        public bool IsEnabled = true;

        // Constructeur : initialise le texte et la position du bouton
        public Button(string text, Vector2 position)
        {
            Text = text;
            Position = position;
        }

        // Dessine le bouton et met à jour sa zone cliquable
        public void Draw(SpriteBatch spriteBatch, SpriteFont font, MouseState mouse)
        {
            // Mesure la taille du texte avec la police utilisée
            Vector2 size = font.MeasureString(Text);

            // Création du rectangle cliquable basé sur la taille du texte
            // → le bouton s’adapte automatiquement à la longueur du texte
            bounds = new Rectangle(
                (int)Position.X,
                (int)Position.Y,
                (int)size.X,
                (int)size.Y
            );

            Color color;

            // Si le bouton est désactivé, on le grise
            if (!IsEnabled)
            {
                color = Color.Gray;
            }
            else
            {
                // Si la souris est au-dessus du bouton :
                // → surbrillance (hover)
                // Sinon : couleur normale
                color = bounds.Contains(mouse.Position)
                    ? Color.Yellow
                    : Color.White;
            }

            // Dessin du texte du bouton
            spriteBatch.DrawString(font, Text, Position, color);
        }
        // Détecte un clic gauche "propre" (press → release)
        public bool IsClicked(MouseState current, MouseState previous)
        {
            // Un bouton désactivé ne peut jamais être cliqué
            if (!IsEnabled) return false;

            return
                // La souris est dans le rectangle du bouton
                bounds.Contains(current.Position) &&

                // Le bouton gauche vient juste d’être pressé
                current.LeftButton == ButtonState.Pressed &&
                previous.LeftButton == ButtonState.Released;
        }
    }


