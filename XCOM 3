        private List<Point> GetMovableCells(Unit unit)
        {
            List<Point> cells = new List<Point>(); // Crée la liste qui contiendra toutes les cases accessibles
            if (unit == null) // Si l'unité est nulle, retourne une liste vide
                return cells;
            int range = unit.MovementPoints; // Nombre d'AP restant pour cette unité = portée de déplacement
            if (unit.MovementPoints <= 0) // Si l'unité n'a plus d'AP, elle ne peut pas se déplacer
                return cells;
            for (int dx = -range; dx <= range; dx++) // Boucle sur toutes les positions relatives possibles dans un carré centré sur l'unité
            {
                for (int dy = -range; dy <= range; dy++)
                {
                    int distance = Math.Abs(dx) + Math.Abs(dy); // Calcul de la distance de Manhattan (|dx| + |dy|)
                    if (distance == 0 || distance > range) // Ignore la case de départ (distance == 0), Ignore les cases hors portée (distance > range).  Remarque : ceci empêche le déplacement gratuit en diagonale
                        continue;
                    int x = unit.Cell.X + dx; // Coordonnées absolues de la case candidate
                    int y = unit.Cell.Y + dy;
                    if (x < 0 || x >= gridWidth || // Ignore les cases en dehors de la grille
                        y < 0 || y >= gridHeight)
                        continue;
                    if (GetUnitAtCell(new Point(x, y)) != null) // Ignore les cases déjà occupées par une autre unité
                        continue;
                    cells.Add(new Point(x, y)); // Case valide → on l'ajoute à la liste
                }
            }
            return cells; // Retourne toutes les cases accessibles à l'unité
        }

        private void HandleFire(Unit shooter)
        {
            foreach (var target in AllUnits())
            {
                if (target.Team == shooter.Team)
                    continue;

                int distance =
                    Math.Abs(target.Cell.X - shooter.Cell.X) +
                    Math.Abs(target.Cell.Y - shooter.Cell.Y);

                if (distance <= shooter.FireRange) // portée de tir
                {
                    // Déclenche l'animation de tir
                    shooter.IsFiring = true;
                    shooter.FireTarget = target.Cell;
                    shooter.FireProgress = 0f;

                    // Tir basé sur la précision avec ajustement distance
                    int roll = random.Next(100); // 0 à 99
                    int effectiveAccuracy = shooter.Accuracy - distance * 5;
                    effectiveAccuracy = Math.Max(effectiveAccuracy, 10); // minimum 10% de chance de toucher

                    // On stocke dans le shooter si le tir sera réussi
                    shooter.WillHit = roll < effectiveAccuracy;

                    // On stocke la cible
                    shooter.PendingTarget = target;

                    // Consomme un point d'action
                    shooter.ActionPoints -= 1;

                    return; // seulement une cible tirée par tour
                }
            }

            Console.WriteLine("Aucune cible à portée");
        }

        private int GetWeaponDamage(string weapon)
        {
            return weapon switch
            {
                "Rifle" => 25,
                "Plasma Rifle" => 30,
                "Plasma Sniper" => 50,
                "Plasma Cannon" => 40,
                "SMG Plasma" => 15,
                _ => 20
            };
        }

        private void StartPlayerTurn()
        {
            foreach (var unit in playerUnits)
                unit.ActionPoints = 3;

            selectedUnit = null;
            cachedMovableCells.Clear();

            currentTurn = TurnState.PlayerTurn;
        }
        private void StartEnemyTurn()
        {
            foreach (var unit in enemyUnits)
                unit.ActionPoints = 2;

            enemyTurnIndex = 0;
            currentTurn = TurnState.EnemyTurn;
        }


        private void UpdateEnemyTurn()
        {
            // Si une animation est en cours, on ATTEND
            if (isActionInProgress)
                return;

            // Si tous les ennemis ont joué → retour joueur
            if (enemyTurnIndex >= enemyUnits.Count)
            {
                StartPlayerTurn();
                return;
            }

            Unit enemy = enemyUnits[enemyTurnIndex];

            // Si cet ennemi n'a plus d'AP → suivant
            if (enemy.ActionPoints <= 0)
            {
                enemyTurnIndex++;
                return;
            }

            // Trouver la cible la plus proche
            Unit closest = null;
            int bestDist = int.MaxValue;

            foreach (var player in playerUnits)
            {
                int dist =
                    Math.Abs(player.Cell.X - enemy.Cell.X) +
                    Math.Abs(player.Cell.Y - enemy.Cell.Y);

                if (dist < bestDist)
                {
                    bestDist = dist;
                    closest = player;
                }
            }

            if (closest == null)
            {
                enemyTurnIndex++;
                return;
            }

            // À portée → tirer
            if (bestDist <= enemy.FireRange)
            {
                HandleFire(enemy);
                isActionInProgress = true;
                enemy.ActionPoints--;
            }
            else
            {
                // Avancer
                Point dir = new Point(
                    Math.Sign(closest.Cell.X - enemy.Cell.X),
                    Math.Sign(closest.Cell.Y - enemy.Cell.Y)
                );

                Point next = new Point(
                    enemy.Cell.X + dir.X,
                    enemy.Cell.Y + dir.Y
                );

                if (GetUnitAtCell(next) == null &&
                    next.X >= 0 && next.X < gridWidth &&
                    next.Y >= 0 && next.Y < gridHeight)
                {
                    enemy.Cell = next;
                    enemy.ActionPoints--;
                }
            }
        }


        private void EnterTargetingMode(Unit shooter)
        {
            isTargeting = true;
            validFireTargets.Clear();

            foreach (var target in AllUnits())
            {
                if (target.Team == shooter.Team)
                    continue;

                int distance =
                    Math.Abs(target.Cell.X - shooter.Cell.X) +
                    Math.Abs(target.Cell.Y - shooter.Cell.Y);

                if (distance <= shooter.FireRange)
                    validFireTargets.Add(target);
            }

            Console.WriteLine("Mode ciblage activé");
        }

        private void FireAtTarget(Unit shooter, Unit target)
        {
            isActionInProgress = true;

            shooter.IsFiring = true;
            shooter.FireTarget = target.Cell;
            shooter.FireProgress = 0f;

            int distance =
                Math.Abs(target.Cell.X - shooter.Cell.X) +
                Math.Abs(target.Cell.Y - shooter.Cell.Y);

            int roll = random.Next(100);
            int effectiveAccuracy = shooter.Accuracy - distance * 5;
            effectiveAccuracy = Math.Max(effectiveAccuracy, 10);

            shooter.WillHit = roll < effectiveAccuracy;
            shooter.PendingTarget = target;

            shooter.ActionPoints -= 1;
        }

        private void UpdateFiringAnimations(GameTime gameTime)
        {
            float fireSpeed = 3f;

            foreach (var unit in AllUnits())
            {
                if (!unit.IsFiring || !unit.FireTarget.HasValue)
                    continue;

                unit.FireProgress +=
                    (float)gameTime.ElapsedGameTime.TotalSeconds * fireSpeed;

                if (unit.FireProgress >= 1f)
                {
                    unit.IsFiring = false;
                    unit.FireProgress = 1f;

                    if (unit.PendingTarget != null)
                    {
                        if (unit.WillHit)
                        {
                            int damage = GetWeaponDamage(unit.Weapon);
                            unit.PendingTarget.Health -= damage;
                            unit.PendingTarget.Health =
                                Math.Max(unit.PendingTarget.Health, 0);

                            if (unit.PendingTarget.Health <= 0)
                            {
                                if (unit.PendingTarget.Team == Team.Player)
                                    playerUnits.Remove(unit.PendingTarget);
                                else
                                    enemyUnits.Remove(unit.PendingTarget);
                            }
                        }

                        unit.PendingTarget = null;
                        unit.WillHit = false;
                    }

                    unit.FireTarget = null;

                    // 🔓 DÉVERROUILLAGE GLOBAL
                    isActionInProgress = false;
                }
            }
        }


