                _spriteBatch.DrawString(font, $"Enemy: {enemy.Name} HP: {enemy.HP}", textPos + new Vector2(0, 80), Color.Red);
            }

        }


        // Méthode pour calculer les cases accessibles à l’unité sélectionnée 1.5.2
        private List<Point> GetMovableCells(Unit unit)
        {
            List<Point> cells = new List<Point>();

            if (unit == null)
                return cells;

            int range = unit.ActionPoints;

            // Simple logique : toutes les cases autour dans un carré
            for (int dx = -range; dx <= range; dx++)
            {
                for (int dy = -range; dy <= range; dy++)
                {
                    int x = unit.Cell.X + dx;
                    int y = unit.Cell.Y + dy;

                    // Vérifie que la case est dans la grille et accessible
                    if (x >= 0 && x < gridWidth && y >= 0 && y < gridHeight)
                    {
                        // Ignore les cases déjà occupées par une unité
                        if (GetUnitAtCell(new Point(x, y)) == null)
                            cells.Add(new Point(x, y));
                    }
                }
            }

            return cells;
        }

        // Méthode pour savoir si un ennemi est adjacent à une unité - 1.5.4
        private Unit GetAdjacentEnemy(Unit unit)
        {
            if (unit == null) return null;

            // Vérifie toutes les cases autour (haut, bas, gauche, droite)
            Point[] directions = new Point[]
            {
        new Point(0, -1),
        new Point(0, 1),
        new Point(-1, 0),
        new Point(1, 0)
            };

            foreach (var dir in directions)
            {
                Point check = new Point(unit.Cell.X + dir.X, unit.Cell.Y + dir.Y);

                if (check.X < 0 || check.X >= gridWidth || check.Y < 0 || check.Y >= gridHeight)
                    continue;

                Unit u = GetUnitAtCell(check);

                if (u != null && u.Team != unit.Team)
                    return u;
            }

            return null;
        }

    }


