            _spriteBatch.DrawString(font, "Class: " + selectedUnit.Class, textPos + new Vector2(0, 20), Color.White);
            _spriteBatch.DrawString(font, "Weapon: " + selectedUnit.Weapon, textPos + new Vector2(0, 40), Color.White);

            // 1.5.4
            _spriteBatch.DrawString(font, $"HP: {selectedUnit.HP}/{selectedUnit.MaxHP}", textPos + new Vector2(0, 60), Color.White);

            Unit enemy = GetAdjacentEnemy(selectedUnit);
