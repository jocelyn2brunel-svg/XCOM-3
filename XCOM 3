        private void DrawGrid()
        {
            // Fonction utilitaire pour convertir cellule → rectangle écran
            Rectangle CellRect(Point p) => new(p.X * cellSize, p.Y * cellSize, cellSize, cellSize);

            // 1️⃣ Dessin des tuiles de sol
            for (int x = 0; x < gridWidth; x++)
                for (int y = 0; y < gridHeight; y++)
                    _spriteBatch.Draw(tileTexture, CellRect(new Point(x, y)), Color.White);

            // 2️⃣ Dessin des obstacles
            foreach (var cell in obstacles)
                _spriteBatch.Draw(obstacleTexture, CellRect(cell), Color.White);

            // 3️⃣ Dessin de la grille (overlay)
            Color gridColor = new Color(255, 255, 255, 80);

            for (int x = 0; x <= gridWidth; x++)
                _spriteBatch.Draw(pixel, new Rectangle(x * cellSize, 0, 1, gridHeight * cellSize), gridColor);

            for (int y = 0; y <= gridHeight; y++)
                _spriteBatch.Draw(pixel, new Rectangle(0, y * cellSize, gridWidth * cellSize, 1), gridColor);
        }



        // Dessine une ligne entre deux points écran à partir d'une texture 1x1
        private void DrawLine(SpriteBatch sb, Vector2 start, Vector2 end, Color color, float thickness)
        {
            Vector2 delta = end - start;
            float length = delta.Length();
            float rotation = (float)Math.Atan2(delta.Y, delta.X);
            sb.Draw(pixel, start, null, color, rotation, Vector2.Zero, new Vector2(length, thickness), SpriteEffects.None, 0f);
        }

        // Dessine une flèche entre deux points écran
        private void DrawArrow(SpriteBatch sb, Vector2 from, Vector2 to, Color color)
        {
            float thickness = 3f, headLength = 12f;
            float headAngle = MathHelper.ToRadians(30f);
            DrawLine(sb, from, to, color, thickness);

            Vector2 dir = Vector2.Normalize(from - to);
            float angle = (float)Math.Atan2(dir.Y, dir.X);

            Vector2 left = to + new Vector2((float)Math.Cos(angle + headAngle), (float)Math.Sin(angle + headAngle)) * headLength;
            Vector2 right = to + new Vector2((float)Math.Cos(angle - headAngle), (float)Math.Sin(angle - headAngle)) * headLength;

            DrawLine(sb, to, left, color, thickness);
            DrawLine(sb, to, right, color, thickness);
        }



        private void DrawHoveredCell(GameTime gameTime)
        {
            if (hoveredCell.X < 0 || hoveredCell.Y < 0) return;

            Rectangle rect = new(hoveredCell.X * cellSize, hoveredCell.Y * cellSize, cellSize, cellSize);

            float pulse = (float)Math.Sin(gameTime.TotalGameTime.TotalSeconds * 6f);
            float alpha = 0.4f + pulse * 0.2f;

            _spriteBatch.Draw(pixel, rect, Color.Yellow * 0.25f);

            int t = 2;
            Vector2 topLeft = new(rect.Left, rect.Top);
            Vector2 topRight = new(rect.Right, rect.Top);
            Vector2 bottomLeft = new(rect.Left, rect.Bottom);
            Vector2 bottomRight = new(rect.Right, rect.Bottom);

            DrawLine(_spriteBatch, topLeft, topRight, Color.Yellow, t);
            DrawLine(_spriteBatch, bottomLeft, bottomRight, Color.Yellow, t);
            DrawLine(_spriteBatch, topLeft, bottomLeft, Color.Yellow, t);
            DrawLine(_spriteBatch, topRight, bottomRight, Color.Yellow, t);
        }



        // Initialise et crée les unités pour les deux équipes : joueur et ennemis
        private void CreateUnits()
        {
            playerUnits.Clear();
            enemyUnits.Clear();

            // Création des unités du joueur
            for (int i = 0; i < 6; i++)
                playerUnits.Add(new Unit(
                    new Point(2 + i, gridHeight - 2),
                    Team.Player,
                    "Soldier " + (i + 1),
                    "Assault",
                    "Rifle",
                    weaponDatabase["Rifle"]
                ));

            // Création des unités ennemies
            for (int i = 0; i < 6; i++)
            {
                var template = enemyPool[random.Next(enemyPool.Count)];
                enemyUnits.Add(new Unit(
                    new Point(2 + i, 1),
                    Team.Enemy,
                    template.Name,
                    template.Class,
                    template.Weapon,
                    weaponDatabase[template.Weapon]
                )
                {
                    ActionPoints = template.ActionPoints
                });
            }

            Console.WriteLine("Units created: 6 player, 6 enemy");
        }



        private void DrawUnits()
        {
            foreach (var unit in playerUnits) DrawUnit(unit);
            foreach (var unit in enemyUnits) DrawUnit(unit);
        }

        private void DrawUnit(Unit unit)
        {
            // Rectangle de l'unité
            Rectangle rect = new(unit.Cell.X * cellSize + 4, unit.Cell.Y * cellSize + 4, cellSize - 8, cellSize - 8);
            _spriteBatch.Draw(pixel, rect, unit.Team == Team.Player ? Color.Blue : Color.Red);

            // Tir en cours
            if (unit.IsFiring && unit.FireTarget.HasValue)
            {
                Vector2 start = (unit.Cell.ToVector2() + new Vector2(0.5f)) * cellSize;
                Vector2 end = (unit.FireTarget.Value.ToVector2() + new Vector2(0.5f)) * cellSize;
                Vector2 pos = Vector2.Lerp(start, end, unit.FireProgress);
                _spriteBatch.Draw(pixel, new Rectangle((int)pos.X - 4, (int)pos.Y - 4, 8, 8), Color.Yellow);
            }

            // Sélection de l'unité
            if (unit == selectedUnit)
                _spriteBatch.Draw(pixel, new Rectangle(unit.Cell.X * cellSize, unit.Cell.Y * cellSize, cellSize, cellSize),
                                  new Color(0, 255, 255, 80));

            // Dessin des cibles (sélectionnée ou survolée)
            DrawTargetHighlight(selectedFireTarget ?? hoveredFireTarget);
        }

        // Helper pour dessiner la cible survolée/sélectionnée avec contour
        private void DrawTargetHighlight(Unit target)
        {
            if (target == null) return;
            Rectangle rect = new(target.Cell.X * cellSize, target.Cell.Y * cellSize, cellSize, cellSize);
            _spriteBatch.Draw(pixel, rect, Color.Red * 0.5f);
            int t = 3;
            Vector2 tl = new(rect.Left, rect.Top), tr = new(rect.Right, rect.Top),
                    bl = new(rect.Left, rect.Bottom), br = new(rect.Right, rect.Bottom);
            DrawLine(_spriteBatch, tl, tr, Color.Red, t);
            DrawLine(_spriteBatch, bl, br, Color.Red, t);
            DrawLine(_spriteBatch, tl, bl, Color.Red, t);
            DrawLine(_spriteBatch, tr, br, Color.Red, t);
        }

        private IEnumerable<Unit> AllUnits()
        {
            foreach (var u in playerUnits) yield return u;
            foreach (var u in enemyUnits) yield return u;
        }

        private Unit GetUnitAtCell(Point cell)
        {
            foreach (var u in AllUnits())
                if (u.Cell == cell) return u;
            return null;
        }

