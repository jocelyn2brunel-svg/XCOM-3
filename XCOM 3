        // de l’un des boutons d’action de l’unité (TIRER, COUVERT, etc.)
        private bool IsMouseOverActionButton(MouseState mouse)
        {
            // On parcourt tous les boutons d’action actuellement affichés
            foreach (var btn in unitActionButtons)
            {
                // On reconstruit le rectangle cliquable du bouton
                // à partir de sa position écran et de sa taille fixe
                Rectangle rect = new Rectangle(
                    (int)btn.Position.X,      // Position X du bouton à l’écran
                    (int)btn.Position.Y,      // Position Y du bouton à l’écran
                    ActionButtonWidth,        // Largeur du bouton
                    ActionButtonHeight        // Hauteur du bouton
                );

                // Si la position actuelle de la souris est à l’intérieur
                // du rectangle du bouton, alors la souris est sur un bouton UI
                if (rect.Contains(mouse.Position))
                    return true; // On peut sortir immédiatement : on a trouvé un bouton
            }

            // Aucun bouton d’action ne contient la souris
            return false;
        }


