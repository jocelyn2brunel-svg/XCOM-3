        private void HandleMainMenu(MouseState mouse)
        {
            foreach (var button in menuButtons) // Parcourt tous les boutons du menu
            {
                // Détecte si le bouton a été cliqué (en comparant l'état actuel et précédent de la souris)
                if (button.IsClicked(mouse, previousMouseState))
                {
                    // Réagit en fonction du texte du bouton
                    switch (button.Text)
                    {
                        case "New Game":
                            MediaPlayer.Stop();           // Arrête la musique du menu
                            currentState = GameState.Playing; // Passe à l'état de jeu
                            LoadMap();                    // Charge une nouvelle carte
                            CreateUnits();                // Crée les unités du joueur et de l'ennemi
                            Console.WriteLine("New game launched !");
                            break;

                        case "Continue":
                            if (hasSavedGame) // Vérifie s'il y a une partie sauvegardée
                            {
                                // Recharge les unités du joueur à partir de la sauvegarde
                                playerUnits = new List<Unit>();
                                foreach (var u in savedPlayerUnits)
                                    playerUnits.Add(new Unit(u));

                                // Recharge les unités ennemies à partir de la sauvegarde
                                enemyUnits = new List<Unit>();
                                foreach (var u in savedEnemyUnits)
                                    enemyUnits.Add(new Unit(u));

                                currentState = GameState.Playing; // Passe à l'état de jeu
                                Console.WriteLine("Game continued!");
                            }
                            else
                            {
                                // Message si aucune sauvegarde n'est disponible
                                Console.WriteLine("No saved game to continue!");
                            }
                            break;

                        case "Encyclopedia":
                            // Placeholder pour ouvrir l'encyclopédie
                            Console.WriteLine("Opening encyclopedia...");
                            break;

                        case "Options":
                            // Passe à l'état du menu Options
                            currentState = GameState.OptionsMenu;
                            Console.WriteLine("Options");
                            break;

