    public class Game1 : Game
    {
        // ===== MENU PRINCIPAL ===== 1.0.0
        // Gère la configuration graphique (résolution, fullscreen, etc.)
        private GraphicsDeviceManager _graphics;

        // Sert à dessiner du texte et des sprites
        private SpriteBatch _spriteBatch;

        // Police utilisée pour le texte
        private SpriteFont font;

        // Liste des boutons du menu principal
        private List<Button> menuButtons;

        // État précédent de la souris (pour détecter un clic unique)
        private MouseState previousMouseState;

        // ===== MUSIQUE ===== 1.1.0
        // Liste de musiques du menu
        //private List<Song> menuSongs;

        // Musique en cours
        private Song currentSong;

        // Générateur de nombre aléatoire
        private Random random = new Random();

        // ===== MENU PRINCIPAL/NEW GAME===== 1.2.0
        // Les états de jeu : Menu principal ou en jeu.
        enum GameState
        {
            MainMenu,
            Playing,
            OptionsMenu // 1.4.0
        }

        private GameState currentState = GameState.MainMenu;

        // ===== NEW GAME ===== 1.3.0
        // --- Grille / Map ---
        private Texture2D pixel; // On crée le pixel dans LoadContent()      
        private int cellSize = 32; // Taille des cases
        private int gridWidth = 20; // Dimension X de la grille
        private int gridHeight = 15; // Dimension Y de la grille

        // ===== NEW GAME/HIGHLIGHT ===== 1.3.1 - 26 janvier 2026 11:33
        // Case survolée par la souris
        private Point hoveredCell = new Point(-1, -1);

        // ===== OPTIONS MENU ===== 1.4.0
        private List<Button> optionsButtons; // 1.4.0
        private float musicVolume = 0.5f; // Valeur initiale du volume (0.0f à 1.0f) // 1.4.0


        public Game1()
        {
            // Initialisation du gestionnaire graphique
            _graphics = new GraphicsDeviceManager(this);

            // Dossier où MonoGame va chercher les assets
            Content.RootDirectory = "Content";

            // Rend le curseur de la souris visible
            IsMouseVisible = true;

            // Permet de redimensionner la fenêtre
            Window.AllowUserResizing = true;

        }



        // Chargement des ressources (appelé une seule fois)
        protected override void LoadContent() // Classe héritée de Game
        {
            // Initialise le SpriteBatch
            _spriteBatch = new SpriteBatch(GraphicsDevice);

            // Charge la police "Arial.spritefont" depuis Content
            font = Content.Load<SpriteFont>("Arial");

            // Création des boutons du menu
            menuButtons = new List<Button>
            {
                new Button("New Game", new Vector2(0, 100)),
                new Button("Continue",       new Vector2(0, 128)),
                new Button("Encyclopedia",    new Vector2(0, 156)),
                new Button("Options",         new Vector2(0, 184)),
                new Button("Quit",         new Vector2(0, 212))
            };


            // Crée la liste et charge les musiques
            //menuSongs = new List<Song>
                {
                //Content.Load<Song>("menu_music_1"),
                //Content.Load<Song>("menu_music_2"),
                //Content.Load<Song>("menu_music_3"),
                //Content.Load<Song>("menu_music_4")
                };

            // Choisir une musique au hasard
            //currentSong = menuSongs[random.Next(menuSongs.Count)];

            // Jouer la musique
            //MediaPlayer.Volume = 0.5f;
            //MediaPlayer.Play(currentSong);


            // Créer le pixel blanc pour les lignes.
            pixel = new Texture2D(GraphicsDevice, 1, 1);
            pixel.SetData(new[] { Color.White });


            // Boutons du Menu Options // 1.4.0
            optionsButtons = new List<Button>
            {
                new Button("Music Volume +", new Vector2(0, 100)),
                new Button("Music Volume -", new Vector2(0, 128)),
                new Button("Back", new Vector2(0, 156))
            };

        }



        // Logique du jeu (appelé à chaque frame)
        protected override void Update(GameTime gameTime) // Classe héritée de Game
        {
            // État actuel de la souris
            MouseState mouse = Mouse.GetState();

            // Si on est dans le Main Menu
            if (currentState == GameState.MainMenu)
            {
                // Vérifie les clics sur chaque bouton
                foreach (var button in menuButtons)
                {
                    // Si le bouton de la souris est cliqué
                    if (button.IsClicked(mouse, previousMouseState))
                    {
                        // Action selon le texte du bouton
                        switch (button.Text)
                        {
                            case "New Game":
                                //MediaPlayer.Stop(); //  Stop la musique
                                currentState = GameState.Playing; // Passe en mode jeu
                                LoadMap();
                                Console.WriteLine("New game launched !");
                                break;

                            case "Continue":
                                Console.WriteLine("Continue a saved game...");
                                break;

                            case "Encylopedia":
                                Console.WriteLine("Open encyclopedia...");
                                break;

                            case "Options":
                                currentState = GameState.OptionsMenu;
                                Console.WriteLine("Options");
                                break;

                            case "Quit":
                                Exit(); // Quitte le jeu
                                break;
                        }
                    }
                }
            }
            
            if (currentState == GameState.Playing)
            {
                int mouseX = mouse.X;
                int mouseY = mouse.Y;

                int cellX = mouseX / cellSize;
                int cellY = mouseY / cellSize;

                // Vérifie que la souris est dans la grille
                if (cellX >= 0 && cellX < gridWidth &&
                    cellY >= 0 && cellY < gridHeight)
                {
                    hoveredCell = new Point(cellX, cellY);
                }
                else
                {
                    hoveredCell = new Point(-1, -1);
                }
            }

            // Détecter les clics dans le Menu Options // 1.4.0
            if (currentState == GameState.OptionsMenu)
            {
                foreach (var button in optionsButtons)
                {
                    if (button.IsClicked(mouse, previousMouseState))
                    {
                        switch (button.Text)
                        {
                            case "Music Volume +":
                                musicVolume += 0.1f;
                                if (musicVolume > 1f) musicVolume = 1f;
                                MediaPlayer.Volume = musicVolume;
                                Console.WriteLine("Volume: " + musicVolume);
                                break;

                            case "Music Volume -":
                                musicVolume -= 0.1f;
                                if (musicVolume < 0f) musicVolume = 0f;
                                MediaPlayer.Volume = musicVolume;
                                Console.WriteLine("Volume: " + musicVolume);
                                break;

                            case "Back":
                                currentState = GameState.MainMenu;
                                break;
                        }
                    }
                }
            }


            // Sauvegarde l’état actuel pour la frame suivante
            previousMouseState = mouse;

            // Quitte le jeu si ESC est appuyé
            if (Keyboard.GetState().IsKeyDown(Keys.Escape))
                Exit();

            base.Update(gameTime);


        }



        // Dessin à l’écran (appelé à chaque frame)
        protected override void Draw(GameTime gameTime) // Classe héritée de Game
        {
            // Nettoie l’écran en noir
            GraphicsDevice.Clear(Color.Black);

            _spriteBatch.Begin();

            // Si on est dans le Main Menu
            if (currentState == GameState.MainMenu)
            {
                // Texte du titre
                string title = "XCOM 3";

                // Position du titre
                Vector2 position = new Vector2(0, 0);

                // Échelle du texte (3x plus grand)
                float scale = 3f;

                // Dessine le titre
                _spriteBatch.DrawString(
                    font,
                    title,
                    position,
                    Color.White,
                    0f,
                    Vector2.Zero,
                    scale,
                    SpriteEffects.None,
                    0f
                );

                // État actuel de la souris
                MouseState mouse = Mouse.GetState();

                // Dessine chaque bouton
                foreach (var button in menuButtons)
                {
                    button.Draw(_spriteBatch, font, mouse);
                }
            }

            // Si on est dans New Game
            else if (currentState == GameState.Playing)
            {
                DrawGrid(); // Dessiner la carte isométrique
                DrawHoveredCell(); // <-- SURBRILLANCE

            }

            // Si on est dans Options // 1.4.0
            else if (currentState == GameState.OptionsMenu)
            {
                string title = "Options";
                _spriteBatch.DrawString(font, title, new Vector2(0, 0), Color.White, 0f, Vector2.Zero, 3f, SpriteEffects.None, 0f);

                MouseState mouse = Mouse.GetState();

                foreach (var button in optionsButtons)
                {
                    button.Draw(_spriteBatch, font, mouse);
                }
            }


            _spriteBatch.End();
            base.Draw(gameTime);
        }



        private void LoadMap()
        {
            // Pour l’instant, on ne charge que la taille de la grille
            // Plus tard : tilemap, collisions, unités, etc.

            gridWidth = 20;
            gridHeight = 15;
            cellSize = 32;

            Console.WriteLine("Map loaded");
        }



        private void DrawGrid()
        {
            Color gridColor = new Color(255, 255, 255, 80);

            // Lignes verticales
            for (int x = 0; x <= gridWidth; x++)
            {
                _spriteBatch.Draw(
                    pixel,
                    new Rectangle(
                        x * cellSize,
                        0,
                        1,
                        gridHeight * cellSize),
                    gridColor);
            }

            // Lignes horizontales
            for (int y = 0; y <= gridHeight; y++)
            {
                _spriteBatch.Draw(
                    pixel,
                    new Rectangle(
                        0,
                        y * cellSize,
                        gridWidth * cellSize,
                        1),
                    gridColor);
            }
        }



        private void DrawHoveredCell() // 1.3.1
        {
            if (hoveredCell.X < 0 || hoveredCell.Y < 0)
                return;

            Rectangle cellRect = new Rectangle(
                hoveredCell.X * cellSize,
                hoveredCell.Y * cellSize,
                cellSize,
                cellSize);

            // Couleur de surbrillance
            Color highlightColor = new Color(255, 255, 0, 80); // Yellow

            _spriteBatch.Draw(pixel, cellRect, highlightColor);
        }

    }





    // ============================
    // Classe Button (bouton simple)
    // ============================
    public class Button
    {
        // Texte affiché
        public string Text;

        // Position à l’écran
        public Vector2 Position;

        // Zone cliquable du bouton
        private Rectangle bounds;

        public Button(string text, Vector2 position)
        {
            Text = text;
            Position = position;
        }



        public void Draw(SpriteBatch spriteBatch, SpriteFont font, MouseState mouse)
        {
            // Mesure la taille du texte
            Vector2 size = font.MeasureString(Text);

            // Définit la zone cliquable
            bounds = new Rectangle(
                (int)Position.X,
                (int)Position.Y,
                (int)size.X,
                (int)size.Y
            );

            // Si la souris est dessus → jaune, sinon blanc
            Color color = bounds.Contains(mouse.Position)
                ? Color.Yellow
                : Color.White;

            // Dessine le texte
            spriteBatch.DrawString(font, Text, Position, color);
        }



        // Détecte un clic unique (Pressed maintenant, Released avant)
        public bool IsClicked(MouseState current, MouseState previous)
        {
            return bounds.Contains(current.Position) &&
                   current.LeftButton == ButtonState.Pressed &&
                   previous.LeftButton == ButtonState.Released;
        }
    }
