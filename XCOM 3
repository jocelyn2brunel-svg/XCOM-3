    public class Button // Classe Button (bouton simple)
    {
        public string Text; // Texte affiché
        public Vector2 Position; // Position à l’écran
        private Rectangle bounds; // Zone cliquable du bouton
        public Button(string text, Vector2 position)
        {
            Text = text;
            Position = position;
        }
        public void Draw(SpriteBatch spriteBatch, SpriteFont font, MouseState mouse)
        {
            Vector2 size = font.MeasureString(Text); // Mesure la taille du texte
            bounds = new Rectangle( // Définit la zone cliquable
                (int)Position.X,
                (int)Position.Y,
                (int)size.X,
                (int)size.Y
            );
            Color color = bounds.Contains(mouse.Position) // Si la souris est dessus → jaune, sinon blanc
                ? Color.Yellow
                : Color.White;
            spriteBatch.DrawString(font, Text, Position, color); // Dessine le texte
        }
        public bool IsClicked(MouseState current, MouseState previous) // Détecte un clic unique (Pressed maintenant, Released avant)
        {
            return bounds.Contains(current.Position) &&
                   current.LeftButton == ButtonState.Pressed &&
                   previous.LeftButton == ButtonState.Released;
        }
    }
    public enum Team // ===== Définir ce qu’est une unité === - 1.5.0
    {
        Player,
        Enemy
    }
    public class Unit
    {
        public Point Cell; // Position sur la grille
        public Team Team; // Joueur ou Ennemi
        public string Name; // On ajoute les données métier (pas du visuel). - 1.5.1
        public string Class;
        public string Weapon;
        public int ActionPoints = 3; // nombre de cases que l'unité peut se déplacer - 1.5.2
        public Unit(Point cell, Team team, string name, string unitClass, string weapon) // 👉 Ces infos serviront uniquement au panneau d’info (HUD). 1.5.1
        {
            Cell = cell;
            Team = team;
            Name = name;
            Class = unitClass;
            Weapon = weapon;
        }
    }
