    // Représente une unité (joueur ou ennemie) sur la grille tactique
    // Contient à la fois l'état stratégique (PA, position, vie)
    // et l'état temporaire lié aux animations (tir, projectiles)
    public class Unit
    {
        // Position de l’unité sur la grille (coordonnées cellule, pas pixels)
        public Point Cell;

        // Équipe de l’unité (Player ou Enemy)
        public Team Team;

        // Nom affiché de l’unité (ex : "Soldat 1", "Alien")
        public string Name;

        // Classe de l’unité (ex : "Rifleman", "Sniper")
        // ⚠️ "Class" est un mot réservé en C#, mais utilisable comme champ
        public string Class;

        // Nom de l’arme équipée (ex : "Rifle", "Plasma Gun")
        public string Weapon;

        // Points d’action disponibles pour ce tour
        // Consommés par les actions (déplacement, tir, etc.)
        public int ActionPoints = 3;

        // Points de déplacement maximum par action
        // Sert à limiter la distance de mouvement
        public int MovementPoints = 3;

        // Données techniques de l’arme (portée, dégâts, précision, etc.)
        public WeaponData WeaponData;

        // Points de vie actuels de l’unité
        public int Health = 100;

        // Points de vie maximum
        public int MaxHealth = 100;

        // Indique si l’unité est en train de tirer
        // Utilisé pour bloquer les actions et jouer l’animation
        public bool IsFiring = false;

        // Cellule ciblée par le tir en cours
        // Nullable → null = aucun tir en préparation
        public Point? FireTarget = null;

        // Avancement de l’animation de tir (0 → 1)
        // Sert à interpoler le projectile
        public float FireProgress = 0f;

        // Résultat du calcul de précision
        // true = le tir touchera, false = il manquera
        public bool WillHit = false;

        // Unité réellement visée par le tir
        // Permet d’appliquer les dégâts à la fin de l’animation
        public Unit PendingTarget = null;

        // Constructeur standard utilisé lors de la création d’une unité
        // au début de la partie ou lors du spawn
        public Unit(Point cell, Team team, string name, string unitClass, string weapon, WeaponData weaponData)
        {
            Cell = cell;                 // Position initiale sur la grille
            Team = team;                 // Équipe de l’unité
            Name = name;                 // Nom affiché
            Class = unitClass;           // Classe de l’unité
            Weapon = weapon;             // Nom de l’arme
            WeaponData = weaponData;     // Données complètes de l’arme
        }

        // Constructeur de copie
        // Utilisé pour du clonage d’unité (simulation, preview, IA, undo, etc.)
        public Unit(Unit other)
        {
            Cell = other.Cell;
            Team = other.Team;
            Name = other.Name;
            Class = other.Class;
            Weapon = other.Weapon;
            WeaponData = other.WeaponData;

            ActionPoints = other.ActionPoints;
            Health = other.Health;
            MaxHealth = other.MaxHealth;
        }
    }


    // Classe servant de modèle pour créer des ennemis préconfigurés
    public class EnemyTemplate
    {
        public string Name;         // Nom de l'ennemi (ex: "Alien Grunt")
        public string Class;        // Type ou rôle de l'ennemi (ex: "Sniper", "Heavy")
        public string Weapon;       // Arme équipée par défaut
        public int ActionPoints;    // Points d'action initiaux (AP) à attribuer à l'ennemi

        // Constructeur pour initialiser un modèle d'ennemi
        public EnemyTemplate(string name, string unitClass, string weapon, int ap)
        {
            Name = name;            // Affecte le nom passé en paramètre
            Class = unitClass;      // Affecte la classe passée en paramètre
            Weapon = weapon;        // Affecte l'arme passée en paramètre
            ActionPoints = ap;      // Définit les points d'action initiaux
        }
    }


    // Classe représentant les données d'une arme
    public class WeaponData
    {
        public string Name;      // Nom de l'arme (ex: "Rifle", "Plasma Cannon")
        public int Damage;       // Dégâts infligés par l'arme
        public int Accuracy;     // Pourcentage de chance de toucher (0-100)
        public int Range;        // Portée maximale de l'arme (en nombre de cases)

        // Constructeur pour initialiser les propriétés de l'arme
        public WeaponData(string name, int damage, int accuracy, int range)
        {
            Name = name;         // Affecte le nom de l'arme
            Damage = damage;     // Affecte la valeur de dégâts
            Accuracy = accuracy; // Affecte la précision
            Range = range;       // Affecte la portée
        }
    }


    // Classe représentant l'interface utilisateur d'une cible pour le tir
    class FireTargetUI
    {
        public Unit Target;       // La cible réelle (unité ennemie) associée à ce bouton/élément UI
        public Rectangle Bounds;  // Zone à l'écran où le bouton/cible est affiché (pour détecter les clics)
        public int HitChance;     // Chance de toucher cette cible en pourcentage (calculée depuis la distance et la précision de l'arme)
    }


}
