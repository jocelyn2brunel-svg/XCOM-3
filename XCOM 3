        /// <summary>
        /// Classe représentant un nœud dans l'algorithme A*
        /// </summary>
        private class AStarNode
        {
            public Point Position;
            public int GCost; // Coût depuis le départ
            public int HCost; // Heuristique (distance estimée vers l'arrivée)
            public int FCost => GCost + HCost; // Coût total
            public AStarNode Parent;

            public AStarNode(Point pos)
            {
                Position = pos;
            }
        }

        /// <summary>
        /// Calcule le chemin optimal avec A* entre deux points
        /// </summary>
        private List<Point> FindPathAStar(Point start, Point goal, int maxDistance)
        {
            // Listes ouvertes et fermées
            List<AStarNode> openList = new List<AStarNode>();
            HashSet<Point> closedList = new HashSet<Point>();

            // Nœud de départ
            AStarNode startNode = new AStarNode(start) { GCost = 0, HCost = ManhattanDistance(start, goal) };
            openList.Add(startNode);

            while (openList.Count > 0)
            {
                // Trouve le nœud avec le plus petit FCost
                AStarNode currentNode = openList[0];
                for (int i = 1; i < openList.Count; i++)
                {
                    if (openList[i].FCost < currentNode.FCost ||
                        (openList[i].FCost == currentNode.FCost && openList[i].HCost < currentNode.HCost))
                    {
                        currentNode = openList[i];
                    }
                }

                openList.Remove(currentNode);
                closedList.Add(currentNode.Position);

                // Si on a atteint la destination
                if (currentNode.Position == goal)
                {
                    return RetracePath(startNode, currentNode);
                }

                // Explore les voisins (4 directions : haut, bas, gauche, droite)
                foreach (Point neighbor in GetNeighbors(currentNode.Position))
                {
                    // Ignore si déjà visité
                    if (closedList.Contains(neighbor))
                        continue;

                    // Ignore si obstacle ou hors limites
                    if (!IsWalkable(neighbor))
                        continue;

                    // Calcule le nouveau coût
                    int newGCost = currentNode.GCost + 1; // Coût de 1 par case

                    // Vérifie si on dépasse la distance maximale
                    if (newGCost > maxDistance)
                        continue;

                    // Cherche si le voisin est déjà dans la liste ouverte
                    AStarNode neighborNode = openList.FirstOrDefault(n => n.Position == neighbor);

                    if (neighborNode == null)
                    {
                        // Ajoute un nouveau nœud
                        neighborNode = new AStarNode(neighbor)
                        {
                            GCost = newGCost,
                            HCost = ManhattanDistance(neighbor, goal),
                            Parent = currentNode
                        };
                        openList.Add(neighborNode);
                    }
                    else if (newGCost < neighborNode.GCost)
                    {
                        // Met à jour si on a trouvé un meilleur chemin
                        neighborNode.GCost = newGCost;
                        neighborNode.Parent = currentNode;
                    }
                }
            }

            // Aucun chemin trouvé
            return new List<Point>();
        }

        /// <summary>
        /// Retrace le chemin depuis le nœud final jusqu'au départ
        /// </summary>
        private List<Point> RetracePath(AStarNode startNode, AStarNode endNode)
        {
            List<Point> path = new List<Point>();
            AStarNode currentNode = endNode;

            while (currentNode != startNode)
            {
                path.Add(currentNode.Position);
                currentNode = currentNode.Parent;
            }

            path.Reverse();
            return path;
        }

        /// <summary>
        /// Retourne les 4 voisins d'une case (haut, bas, gauche, droite)
        /// </summary>
        private List<Point> GetNeighbors(Point cell)
        {
            return new List<Point>
            {
                new Point(cell.X, cell.Y - 1), // Haut
                new Point(cell.X, cell.Y + 1), // Bas
                new Point(cell.X - 1, cell.Y), // Gauche
                new Point(cell.X + 1, cell.Y)  // Droite
            };
        }

        /// <summary>
        /// Vérifie si une case est praticable (pas d'obstacle, pas d'unité, dans les limites)
        /// </summary>
        private bool IsWalkable(Point cell)
        {
            // Hors limites
            if (cell.X < 0 || cell.Y < 0 || cell.X >= gridWidth || cell.Y >= gridHeight)
                return false;

            // Obstacle
            if (obstacles.Contains(cell))
                return false;

            // Unité présente
            if (GetUnitAtCell(cell) != null)
                return false;

            return true;
        }

        /// <summary>
        /// Calcule la distance de Manhattan entre deux points
        /// </summary>
        private int ManhattanDistance(Point a, Point b)
        {
            return Math.Abs(a.X - b.X) + Math.Abs(a.Y - b.Y);
        }

        /// <summary>
        /// Obtient toutes les cellules accessibles avec A* dans un rayon donné
        /// </summary>
        private List<Point> GetMovableCells(Unit u)
        {
            var cells = new List<Point>();
            if (u == null || u.MovementPoints <= 0) return cells;

            int maxRange = u.MovementPoints;

            // Parcourt toutes les cases dans un carré englobant
            for (int x = u.Cell.X - maxRange; x <= u.Cell.X + maxRange; x++)
            {
                for (int y = u.Cell.Y - maxRange; y <= u.Cell.Y + maxRange; y++)
                {
                    Point targetCell = new Point(x, y);

                    // Ignore la case de départ
                    if (targetCell == u.Cell)
                        continue;

                    // Ignore hors limites
                    if (x < 0 || y < 0 || x >= gridWidth || y >= gridHeight)
                        continue;

                    // Ignore obstacles et unités
                    if (!IsWalkable(targetCell))
                        continue;

                    // Utilise A* pour trouver le chemin
                    var path = FindPathAStar(u.Cell, targetCell, maxRange);

                    // Si un chemin existe et qu'il est dans la portée
                    if (path.Count > 0 && path.Count <= maxRange)
                    {
                        cells.Add(targetCell);
                    }
                }
            }

            return cells;
        }

