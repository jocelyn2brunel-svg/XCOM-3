    // Je représente un bouton très simple à l’écran
    // Juste du texte sur lequel on peut cliquer
    public class Button
    {
        // Le texte que j’affiche (ex : "Play", "Options", "Quit")
        public string Text;

        // Ma position à l’écran (en pixels)
        public Vector2 Position;

        // Ma zone cliquable réelle
        // Elle est privée parce que personne d’autre n’a à la modifier
        private Rectangle bounds;

        public bool IsEnabled = true; // true = clic possible, false = grisé et non cliquable

        // Quand on me crée, on me donne mon texte et ma position
        public Button(string text, Vector2 position)
        {
            Text = text;
            Position = position;
        }

        // Cette méthode me dessine à l’écran
        public void Draw(SpriteBatch spriteBatch, SpriteFont font, MouseState mouse)
        {
            // Je mesure la taille du texte avec la police actuelle
            Vector2 size = font.MeasureString(Text);

            // À partir de cette taille, je définis ma zone cliquable
            bounds = new Rectangle(
                (int)Position.X,
                (int)Position.Y,
                (int)size.X,
                (int)size.Y
            );

            Color color;

            if (!IsEnabled)
            {
                color = Color.Gray; // gris si désactivé
            }
            else
            {
                // Est-ce que la souris est au-dessus de moi ?
                color = bounds.Contains(mouse.Position)
                    ? Color.Yellow
                    : Color.White;
            }
            // Je dessine mon texte à l’écran
            spriteBatch.DrawString(font, Text, Position, color); // Dessine le texte
        }

        // Est-ce que je viens d’être cliqué ?
        public bool IsClicked(MouseState current, MouseState previous) // Détecte un clic unique (Pressed maintenant, Released avant)
        {

            if (!IsEnabled) return false; // impossible de cliquer si désactivé

            return
                // La souris est sur moi
                bounds.Contains(current.Position) &&

                // Le bouton gauche est appuyé maintenant
                current.LeftButton == ButtonState.Pressed &&

                // …mais il était relâché à la frame précédente
                previous.LeftButton == ButtonState.Released;
        }

    }

    // ===== Définir ce qu’est une unité ===
    public enum Team
    {
        Player,
        Enemy
    }


    public class Unit // Je définis ce qu’est une unité dans le jeu
    {
        public Point Cell; // Où je me trouve sur la grille (case X / Y)
        public Team Team; // À quelle équipe j’appartiens (joueur ou ennemi)
        public string Name; // Mon nom (ex : "Soldat", "Alien", "Sniper")
        public string Class; // Ma classe (ex : Assault, Medic, Heavy)
        public string Weapon; // Mon arme équipée
        public int ActionPoints = 3; // Combien de points d’action j’ai par tour
        public int MovementPoints = 3; // combien de cases l’unité peut bouger
        public int FireRange = 5; // portée de tir
        public int Accuracy = 75; // en pourcentage, 0 = jamais, 100 = toujours
        public int Health = 100; // points de vie maximum par défaut
        public int MaxHealth = 100; // facultatif, pour réinitialiser ou afficher
        public bool IsFiring = false;        // l’unité est en train de tirer
        public Point? FireTarget = null;     // cible du tir pour dessiner le projectile
        public float FireProgress = 0f;      // progression de l’animation (0 → 1)
        public bool WillHit = false;          // Tir prévu réussi ou raté
        public Unit PendingTarget = null;     // La cible sur laquelle appliquer les dégâts



        // Quand une unité est créée, on DOIT lui fournir
        // sa position, son équipe, son nom, sa classe et son arme
        public Unit(Point cell, Team team, string name, string unitClass, string weapon)
        {
            // Je mémorise ma position de départ
            Cell = cell;

            // Je mémorise mon équipe
            Team = team;

            // Je mémorise mon nom
            Name = name;

            // "Class" est un mot réservé, donc on utilise "unitClass" en paramètre
            // puis on l’assigne au champ Class
            Class = unitClass;

            // Je mémorise mon arme
            Weapon = weapon;

            Accuracy = GetWeaponAccuracy(weapon);

        }

        private int GetWeaponAccuracy(string weapon)
        {
            return weapon switch
            {
                "Rifle" => 80,
                "Plasma Rifle" => 75,
                "Plasma Sniper" => 90,
                "Plasma Cannon" => 70,
                "SMG Plasma" => 60,
                _ => 75
            };
        }

    }
