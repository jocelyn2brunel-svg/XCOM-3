        private void HandleOptionsMenu(MouseState mouse)
        {
            // Parcourt tous les boutons du menu Options
            foreach (var button in optionsButtons)
            {
                // Vérifie si le bouton a été cliqué (appui souris depuis le dernier frame)
                if (button.IsClicked(mouse, previousMouseState))
                {
                    // Effectue une action selon le texte du bouton
                    switch (button.Text)
                    {
                        case "Music Volume +":
                            // Augmente le volume de 0.1 mais ne dépasse pas 1.0 (valeur max)
                            musicVolume = Math.Min(musicVolume + 0.1f, 1f);
                            MediaPlayer.Volume = musicVolume; // applique le volume
                            Console.WriteLine("Volume: " + musicVolume); // debug
                            break;

                        case "Music Volume -":
                            // Diminue le volume de 0.1 mais ne descend pas sous 0.0 (valeur min)
                            musicVolume = Math.Max(musicVolume - 0.1f, 0f);
                            MediaPlayer.Volume = musicVolume; // applique le volume
                            Console.WriteLine("Volume: " + musicVolume); // debug
                            break;

                        case "Back":
                            // Retour au menu principal
                            currentState = GameState.MainMenu;
                            break;
                    }
                }
            }

            // --- Glisser le curseur de la barre de volume ---
            // Commence le glissement si la souris est enfoncée sur la barre
            if (mouse.LeftButton == ButtonState.Pressed &&
                volumeBar.Contains(mouse.Position)) draggingVolume = true;

            // Stoppe le glissement dès que le bouton est relâché
            if (mouse.LeftButton == ButtonState.Released) draggingVolume = false;

            // Si le curseur est en train d'être glissé
            if (draggingVolume)
            {
                // Calcule le pourcentage selon la position de la souris sur la barre
                float percent = (mouse.X - volumeBar.X) / (float)volumeBar.Width;

                // Limite la valeur entre 0 et 1
                musicVolume = MathHelper.Clamp(percent, 0f, 1f);

                // Applique le volume à MediaPlayer
                MediaPlayer.Volume = musicVolume;
            }

            // --- Mise à jour de l'affichage de la barre de volume et du curseur ---
            // Remplissage de la barre selon le volume
            volumeFill = new Rectangle(
                volumeBar.X,
                volumeBar.Y,
                (int)(volumeBar.Width * musicVolume), // largeur proportionnelle au volume
                volumeBar.Height
            );

            // Position du curseur (handle)
            int handleX = volumeBar.X + volumeFill.Width - 5; // léger décalage pour centrer
            volumeHandle = new Rectangle(
                handleX,
                volumeBar.Y - 4,
                10, // largeur du curseur
                volumeBar.Height + 8 // hauteur du curseur légèrement plus grande que la barre
            );
        }

        private void HandlePlayerTurn(MouseState mouse, bool leftClick)
        {
            // --- Conversion souris écran → monde / grille ---
            Vector2 mouseWorldPos =
                (new Vector2(mouse.X, mouse.Y)
                - new Vector2(GraphicsDevice.Viewport.Width / 2,
                              GraphicsDevice.Viewport.Height / 2))
                / zoom + cameraOffset;

            int cellX = (int)(mouseWorldPos.X / cellSize);
            int cellY = (int)(mouseWorldPos.Y / cellSize);

            // --- Cellule survolée ---
            if (cellX >= 0 && cellX < gridWidth &&
                cellY >= 0 && cellY < gridHeight)
                hoveredCell = new Point(cellX, cellY);
            else
                hoveredCell = new Point(-1, -1);

            // Si la souris est sur le bouton Tirer, on annule le hover grille
            if (selectedUnit != null && fireButton.Contains(mouse.Position))
                hoveredCell = new Point(-1, -1);

            // --- Flèche de déplacement ---
            showMoveArrow = false;
            if (selectedUnit != null &&
                selectedUnit.ActionPoints > 0 &&
                hoveredCell.X != -1 &&
                cachedMovableCells.Contains(hoveredCell))
            {
                arrowFromCell = selectedUnit.Cell;
                arrowToCell = hoveredCell;
                showMoveArrow = true;
            }

            // --- Détection clic UI ---
            bool clickOnUI =
                fireButton.Contains(mouse.Position) ||
                IsMouseOverActionButton(mouse);

            // --- Clic gauche sur la grille ---
            if (leftClick && !clickOnUI)
            {
                HandleGridClick(new Point(cellX, cellY));
            }

            // --- Boutons d'action d'unité ---
            if (leftClick)
            {
                HandleUnitActionButtons(mouse);
            }

            // --- Sélection des cibles de tir ---
            if (leftClick && showFireTargets)
            {
                foreach (var ui in fireTargetsUI)
                {
                    if (ui.Bounds.Contains(mouse.Position))
                    {
                        selectedFireTarget = ui.Target;
                        break;
                    }
                }
            }

            // --- Clic droit : annulation ---
            if (mouse.RightButton == ButtonState.Pressed &&
                previousMouseState.RightButton == ButtonState.Released)
            {
                CancelSelection();
            }

            // --- Bouton Tirer ---
            fireButtonHovered = fireButton.Contains(mouse.Position);
            if (fireButtonHovered && leftClick &&
                selectedUnit != null &&
                selectedFireTarget != null &&
                selectedUnit.ActionPoints > 0)
            {
                FireAtTarget(selectedUnit, selectedFireTarget);
                UpdateFireTargets();
            }

            // --- Bouton Fin de tour ---
            endTurnHovered = endTurnButton.Contains(mouse.Position);
            if (endTurnHovered && leftClick && !isActionInProgress)
            {
                StartEnemyTurn();
            }
        }

        private void HandleGridClick(Point clickedCell)
        {
            Unit clickedUnit = GetUnitAtCell(clickedCell);

            if (clickedUnit != null)
            {
                selectedUnit = clickedUnit;

                if (selectedUnit.Team == Team.Player)
                {
                    cachedMovableCells = GetMovableCells(selectedUnit);
                    UpdateFireTargets();
                }
                else
                {
                    cachedMovableCells.Clear();
                    showMoveArrow = false;
                }
            }
            else if (selectedUnit != null && selectedUnit.ActionPoints > 0)
            {
                var movableCells = GetMovableCells(selectedUnit);
                if (movableCells.Contains(clickedCell))
                {
                    int cost =
                        Math.Abs(clickedCell.X - selectedUnit.Cell.X) +
                        Math.Abs(clickedCell.Y - selectedUnit.Cell.Y);

                    if (cost <= selectedUnit.MovementPoints)
                    {
                        selectedUnit.Cell = clickedCell;
                        selectedUnit.ActionPoints--;
                        UpdateFireTargets();

                        cachedMovableCells = selectedUnit.ActionPoints > 0
                            ? GetMovableCells(selectedUnit)
                            : new List<Point>();
                    }
                }
            }
        }

