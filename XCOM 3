        // Dessine une unité sur la grille avec ses effets (tir, sélection, ciblage)
        private void DrawUnit(Unit unit)
        {
            // --- 1️⃣ Rectangle de l’unité ---
            // On crée un rectangle pour dessiner l’unité légèrement plus petit que la cellule
            Rectangle rect = new Rectangle(
                unit.Cell.X * cellSize + 4,   // décalage à l’intérieur de la cellule
                unit.Cell.Y * cellSize + 4,
                cellSize - 8,                 // largeur réduite
                cellSize - 8                  // hauteur réduite
            );

            // Couleur selon l’équipe : bleu pour joueur, rouge pour ennemi
            Color color = (unit.Team == Team.Player)
                ? Color.Blue
                : Color.Red;

            // Dessin de l’unité (rectangle simple pour le moment)
            _spriteBatch.Draw(pixel, rect, color);

            // --- 2️⃣ Tir en cours ---
            if (unit.IsFiring && unit.FireTarget.HasValue)
            {
                Point target = unit.FireTarget.Value;

                // Centre de la cellule de départ et de la cellule cible
                Vector2 start = new Vector2(unit.Cell.X + 0.5f, unit.Cell.Y + 0.5f) * cellSize;
                Vector2 end = new Vector2(target.X + 0.5f, target.Y + 0.5f) * cellSize;

                // Position intermédiaire du projectile selon la progression du tir (0 → 1)
                Vector2 pos = Vector2.Lerp(start, end, unit.FireProgress);

                // Rectangle pour représenter le projectile
                Rectangle proj = new Rectangle((int)pos.X - 4, (int)pos.Y - 4, 8, 8);

                // Dessin du projectile
                _spriteBatch.Draw(pixel, proj, Color.Yellow);
            }

            // --- 3️⃣ Sélection de l’unité ---
            if (unit == selectedUnit)
            {
                // Rectangle de la cellule entière pour le contour de sélection
                Rectangle outline = new Rectangle(
                    unit.Cell.X * cellSize,
                    unit.Cell.Y * cellSize,
                    cellSize,
                    cellSize
                );

                // Dessin d’un contour semi-transparent cyan
                _spriteBatch.Draw(pixel, outline, new Color(0, 255, 255, 80));
            }

            // --- 4️⃣ Affichage de la cible sélectionnée pour tir ---
            if (selectedFireTarget != null)
            {
                // Rectangle de la cellule cible
                Rectangle targetRect = new Rectangle(
                    selectedFireTarget.Cell.X * cellSize,
                    selectedFireTarget.Cell.Y * cellSize,
                    cellSize,
                    cellSize
                );

                // Fond semi-transparent rouge
                _spriteBatch.Draw(pixel, targetRect, Color.Red * 0.5f);

                // Contour plus visible (optionnel)
                int thickness = 3;
                DrawLine(_spriteBatch, new Vector2(targetRect.Left, targetRect.Top), new Vector2(targetRect.Right, targetRect.Top), Color.Red, thickness);
                DrawLine(_spriteBatch, new Vector2(targetRect.Left, targetRect.Bottom), new Vector2(targetRect.Right, targetRect.Bottom), Color.Red, thickness);
                DrawLine(_spriteBatch, new Vector2(targetRect.Left, targetRect.Top), new Vector2(targetRect.Left, targetRect.Bottom), Color.Red, thickness);
                DrawLine(_spriteBatch, new Vector2(targetRect.Right, targetRect.Top), new Vector2(targetRect.Right, targetRect.Bottom), Color.Red, thickness);
            }

            // --- 5️⃣ Contour de la cible survolée ou sélectionnée ---
            Unit targetToHighlight = selectedFireTarget ?? hoveredFireTarget; // priorise la cible sélectionnée

            if (targetToHighlight != null)
            {
                Rectangle targetRect = new Rectangle(
                    targetToHighlight.Cell.X * cellSize,
                    targetToHighlight.Cell.Y * cellSize,
                    cellSize,
                    cellSize
                );

                // Fond semi-transparent pour indiquer la cible
                _spriteBatch.Draw(pixel, targetRect, Color.Red * 0.5f);

                // Contour plus visible pour accentuer le survol ou la sélection
                int thickness = 3;
                DrawLine(_spriteBatch, new Vector2(targetRect.Left, targetRect.Top), new Vector2(targetRect.Right, targetRect.Top), Color.Red, thickness);
                DrawLine(_spriteBatch, new Vector2(targetRect.Left, targetRect.Bottom), new Vector2(targetRect.Right, targetRect.Bottom), Color.Red, thickness);
                DrawLine(_spriteBatch, new Vector2(targetRect.Left, targetRect.Top), new Vector2(targetRect.Left, targetRect.Bottom), Color.Red, thickness);
                DrawLine(_spriteBatch, new Vector2(targetRect.Right, targetRect.Top), new Vector2(targetRect.Right, targetRect.Bottom), Color.Red, thickness);
            }
        }


        // Retourne toutes les unités présentes sur la carte (joueur + ennemis)
        // IEnumerable<Unit> permet d’itérer sur toutes les unités sans créer de nouvelle liste
        private IEnumerable<Unit> AllUnits()
        {
            // Parcourt toutes les unités du joueur et les "yield" une par une
            foreach (var u in playerUnits)
                yield return u;  // "yield return" renvoie l’élément courant à l’itérateur

            // Parcourt toutes les unités ennemies et les "yield" une par une
            foreach (var u in enemyUnits)
                yield return u;
        }


        // Retourne l'unité se trouvant sur une cellule donnée, ou null si aucune unité n'est présente
        private Unit GetUnitAtCell(Point cell)
        {
            // Parcourt toutes les unités (joueur + ennemis) grâce à la méthode AllUnits()
            foreach (var unit in AllUnits())
                // Si l'unité se trouve sur la cellule recherchée
                if (unit.Cell == cell)
                    return unit; // On renvoie immédiatement cette unité

            // Si aucune unité n'a été trouvée sur la cellule, on retourne null
            return null;
        }


