        // Retourne une liste de cellules sur lesquelles l'unité peut se déplacer
        private List<Point> GetMovableCells(Unit unit)
        {
            List<Point> cells = new List<Point>(); // liste des cellules accessibles

            // Si l'unité est null, on retourne une liste vide
            if (unit == null)
                return cells;

            int range = unit.MovementPoints; // nombre de cases que l'unité peut parcourir

            // Si l'unité n'a plus de points de mouvement, aucune cellule n'est accessible
            if (unit.MovementPoints <= 0)
                return cells;

            // Boucle sur un carré autour de l'unité, de -range à +range en X et Y
            for (int dx = -range; dx <= range; dx++)
            {
                for (int dy = -range; dy <= range; dy++)
                {
                    int distance = Math.Abs(dx) + Math.Abs(dy); // distance de Manhattan

                    // Ignorer la case de départ ou les cases hors de portée
                    if (distance == 0 || distance > range)
                        continue;

                    // Coordonnées de la cellule candidate
                    int x = unit.Cell.X + dx;
                    int y = unit.Cell.Y + dy;

                    // Vérifier que la cellule est dans la grille
                    if (x < 0 || x >= gridWidth || y < 0 || y >= gridHeight)
                        continue;

                    // Vérifier qu'il n'y a pas d'unité déjà sur la cellule
                    if (GetUnitAtCell(new Point(x, y)) != null)
                        continue;

                    // Vérifier qu'il n'y a pas d'obstacle sur la cellule
                    if (obstacles.Contains(new Point(x, y)))
                        continue;

                    // Si toutes les conditions sont bonnes, ajouter la cellule à la liste
                    cells.Add(new Point(x, y));
                }
            }

            // Retourner toutes les cellules accessibles
            return cells;
        }


        // Gère l'action de tir d'une unité (shooter) vers une cible valide
        private void HandleFire(Unit shooter)
        {
            // Si l'unité n'a plus de points d'action, elle ne peut pas tirer
            if (shooter.ActionPoints <= 0)
                return;

            // Parcourt toutes les unités (joueurs et ennemis)
            foreach (var target in AllUnits())
            {
                // Ignorer les alliés
                if (target.Team == shooter.Team)
                    continue;

                // Calcul de la distance de Manhattan entre le tireur et la cible
                int distance =
                    Math.Abs(target.Cell.X - shooter.Cell.X) +
                    Math.Abs(target.Cell.Y - shooter.Cell.Y);

                // Ignorer les cibles hors portée
                if (distance > shooter.WeaponData.Range)
                    continue;

                // Vérifier qu'il y a une ligne de vue (LOS) entre le tireur et la cible
                if (!HasLineOfSight(shooter.Cell, target.Cell))
                    continue;

                // La cible est valide : on configure l'état de tir du tireur
                shooter.IsFiring = true;               // l'unité est en train de tirer
                shooter.FireTarget = target.Cell;      // cellule visée
                shooter.FireProgress = 0f;             // progression du tir (animation)

                // Calcul d'un jet aléatoire pour déterminer si le tir touche
                int roll = random.Next(100);           // nombre aléatoire entre 0 et 99
                int effectiveAccuracy =
                    shooter.WeaponData.Accuracy - distance * 5; // pénalité de distance
                effectiveAccuracy = Math.Max(effectiveAccuracy, 10); // min 10% de chance de toucher

                // Déterminer si le tir touchera la cible
                shooter.WillHit = roll < effectiveAccuracy;

                // Sauvegarder l'unité ciblée
                shooter.PendingTarget = target;

                // Dépenser un point d'action
                shooter.ActionPoints -= 1;

                // On ne tire qu'une fois, donc on sort de la boucle
                return;
            }

            // Si aucune cible n'est valide (hors portée ou LOS bloqué)
            Console.WriteLine("Aucune cible valide (portée + LOS)");
        }


        // Démarre le tour du joueur en réinitialisant les unités et l'état du jeu
        private void StartPlayerTurn()
        {
            // Réinitialise les points d'action de toutes les unités du joueur
            foreach (var unit in playerUnits)
                unit.ActionPoints = 3; // chaque unité commence son tour avec 3 PA

            // Aucunité sélectionnée au début du tour
            selectedUnit = null;

            // Vider le cache des cellules où les unités pouvaient se déplacer
            cachedMovableCells.Clear();

            // Changer l'état du tour pour indiquer que c'est le tour du joueur
            currentTurn = TurnState.PlayerTurn;
        }


        // Démarre le tour des ennemis en réinitialisant leurs unités et l'état du tour
        private void StartEnemyTurn()
        {
            // Réinitialise les points d'action de toutes les unités ennemies
            foreach (var unit in enemyUnits)
                unit.ActionPoints = 2; // chaque unité ennemie peut agir jusqu'à 2 fois par tour

            // Réinitialise l'indice de l'ennemi actif
            // (utile si tu fais tourner les ennemis un par un pendant leur tour)
            enemyTurnIndex = 0;

            // Change l'état du tour pour indiquer que c'est le tour de l'ennemi
            currentTurn = TurnState.EnemyTurn;
        }


        // Met à jour le tour de l'ennemi, appelé à chaque frame pendant le tour des ennemis
        private void UpdateEnemyTurn()
        {
            // Si toutes les unités ennemies ont agi, on passe au tour du joueur
            if (enemyTurnIndex >= enemyUnits.Count)
            {
                StartPlayerTurn(); // réinitialise les AP des joueurs, change le tour
                return;
            }

            // On récupère l'ennemi actuel qui doit agir
            Unit enemy = enemyUnits[enemyTurnIndex];

            // Si l'ennemi est en train de tirer, on attend la fin de son tir avant d'agir
            if (enemy.IsFiring)
                return;

            // Si l'ennemi n'a plus de points d'action, on passe à l'unité ennemie suivante
            if (enemy.ActionPoints <= 0)
            {
                enemyTurnIndex++;
                return;
            }

            // Cherche le joueur le plus proche
            Unit closest = null;
            int bestDist = int.MaxValue; // distance minimale initialisée au maximum possible
            foreach (var player in playerUnits)
            {
                // Calcul de la distance Manhattan (X + Y)
                int dist = Math.Abs(player.Cell.X - enemy.Cell.X) +
                           Math.Abs(player.Cell.Y - enemy.Cell.Y);

                // On garde le joueur le plus proche
                if (dist < bestDist)
                {
                    bestDist = dist;
                    closest = player;
                }
            }

            // Si aucun joueur n'a été trouvé (cas improbable), on passe à l'ennemi suivant
            if (closest == null)
            {
                enemyTurnIndex++;
                return;
            }

            // Si le joueur le plus proche est à portée et visible
            if (bestDist <= enemy.WeaponData.Range && HasLineOfSight(enemy.Cell, closest.Cell))
            {
                HandleFire(enemy); // démarre le tir
                return; // on attend que le tir se termine avant d'agir
            }

            // Déplacement vers le joueur le plus proche
            Point dir = new Point(
                Math.Sign(closest.Cell.X - enemy.Cell.X), // +1 ou -1 en X
                Math.Sign(closest.Cell.Y - enemy.Cell.Y)  // +1 ou -1 en Y
            );
            Point next = new Point(enemy.Cell.X + dir.X, enemy.Cell.Y + dir.Y);

            // Vérifie que la case suivante est libre et dans la grille
            if (GetUnitAtCell(next) == null && !obstacles.Contains(next) &&
                next.X >= 0 && next.X < gridWidth &&
                next.Y >= 0 && next.Y < gridHeight)
            {
                enemy.Cell = next; // déplace l'ennemi
                enemy.ActionPoints--; // dépense 1 point d'action
            }
            else
            {
                enemy.ActionPoints = 0; // bloqué, consomme les AP pour éviter boucle infinie
            }

            // Si l'ennemi n'a plus de points d'action après déplacement, on passe à l'unité suivante
            if (enemy.ActionPoints <= 0)
            {
                enemyTurnIndex++;
            }
        }



        // Lance un tir d'une unité "shooter" sur une unité "target"
        private void FireAtTarget(Unit shooter, Unit target)
        {
            // Si l'unité n'a plus de points d'action, elle ne peut pas tirer
            if (shooter.ActionPoints <= 0)
                return;

            // Vérifie que la ligne de vue est dégagée
            if (!HasLineOfSight(shooter.Cell, target.Cell))
                return;

            // Calcul de la distance Manhattan entre le tireur et la cible
            int distance =
                Math.Abs(target.Cell.X - shooter.Cell.X) +
                Math.Abs(target.Cell.Y - shooter.Cell.Y);

            // Si la cible est hors portée de l'arme, on abandonne le tir
            if (distance > shooter.WeaponData.Range)
                return;

            // On marque qu'une action est en cours pour bloquer d'autres actions simultanées
            isActionInProgress = true;

            // L'unité tire : état utilisé par l'animation ou mise à jour de projectile
            shooter.IsFiring = true;

            // Position de la cible pour le tir
            shooter.FireTarget = target.Cell;

            // Réinitialise la progression du tir (0 = début)
            shooter.FireProgress = 0f;

            // Jet aléatoire pour déterminer si le tir touche
            int roll = random.Next(100);

            // Calcul de l'accuracy effective en fonction de la distance
            int effectiveAccuracy =
                shooter.WeaponData.Accuracy - distance * 5;

            // Garantit une précision minimale de 10%
            effectiveAccuracy = Math.Max(effectiveAccuracy, 10);

            // Détermine si le tir va toucher ou rater
            shooter.WillHit = roll < effectiveAccuracy;

            // Référence vers la cible qui sera affectée par le tir
            shooter.PendingTarget = target;

            // Consomme un point d'action pour le tir
            shooter.ActionPoints -= 1;

            // Met à jour les cibles affichées à l'écran (UI)
            UpdateFireTargets();

            // Réinitialise la cible sélectionnée pour le joueur
            selectedFireTarget = null;
        }


        // Met à jour les animations de tir pour toutes les unités
        private void UpdateFiringAnimations(GameTime gameTime)
        {
            // Vitesse de progression du tir (plus élevé = projectile plus rapide)
            float fireSpeed = 3f;

            // Parcourt toutes les unités (joueur + ennemis)
            foreach (var unit in AllUnits())
            {
                // Ignore les unités qui ne tirent pas ou n'ont pas de cible
                if (!unit.IsFiring || !unit.FireTarget.HasValue)
                    continue;

                // Avance la progression de l'animation du tir en fonction du temps écoulé
                unit.FireProgress +=
                    (float)gameTime.ElapsedGameTime.TotalSeconds * fireSpeed;

                // Quand le tir atteint la fin (progression >= 1)
                if (unit.FireProgress >= 1f)
                {
                    // Le tir est terminé, on réinitialise l'état de tir
                    unit.IsFiring = false;
                    unit.FireProgress = 0f;

                    // Si une cible est en attente d'être affectée par le tir
                    if (unit.PendingTarget != null)
                    {
                        // Si le tir devait toucher
                        if (unit.WillHit)
                        {
                            int damage = unit.WeaponData.Damage;

                            // Applique les dégâts à la cible
                            unit.PendingTarget.Health -= damage;

                            // S'assure que la vie ne descende pas en dessous de 0
                            unit.PendingTarget.Health =
                                Math.Max(unit.PendingTarget.Health, 0);

                            // Si la cible est morte, on la retire de la liste de l'équipe
                            if (unit.PendingTarget.Health <= 0)
                            {
                                if (unit.PendingTarget.Team == Team.Player)
                                    playerUnits.Remove(unit.PendingTarget);
                                else
                                    enemyUnits.Remove(unit.PendingTarget);
                            }
                        }

                        // Réinitialise les informations de cible et de réussite du tir
                        unit.PendingTarget = null;
                        unit.WillHit = false;
                    }

                    // Réinitialise la cible du tir et libère le flag d'action en cours
                    unit.FireTarget = null;
                    isActionInProgress = false;

                    // On ne traite qu'un tir à la fois par frame
                    return;
                }
            }
        }


        // Génère des obstacles aléatoires sur la grille
        private void GenerateObstacles(int count)
        {
            // Vide la liste d'obstacles existants
            obstacles.Clear();

            // On crée des "clusters" de 3 obstacles pour éviter qu'ils soient dispersés individuellement
            int clusters = count / 3;

            // Pour chaque cluster
            for (int i = 0; i < clusters; i++)
            {
                // Position centrale du cluster aléatoire, en laissant 2 cases de marge sur les bords
                int cx = random.Next(2, gridWidth - 2);
                int cy = random.Next(2, gridHeight - 2);

                // Pour chaque obstacle dans le cluster (ici 3 par cluster)
                for (int j = 0; j < 3; j++)
                {
                    // Décalage aléatoire par rapport au centre (-1, 0 ou +1)
                    int x = cx + random.Next(-1, 2);
                    int y = cy + random.Next(-1, 2);

                    Point p = new Point(x, y);

                    // Vérifie si la cellule est dans une zone de spawn de joueur/enemi (évite les bords)
                    bool spawnZone =
                        y >= gridHeight - 2 ||  // zone de spawn joueur
                        y <= 1;                  // zone de spawn ennemi

                    if (spawnZone)
                        continue; // ignore cette cellule pour ne pas bloquer le spawn

                    // Vérifie que la cellule est dans la grille
                    if (x >= 0 && x < gridWidth && y >= 0 && y < gridHeight)
                        obstacles.Add(p); // ajoute l'obstacle
                }
            }
        }


        // Vérifie s'il y a une ligne de vue directe entre deux cellules (sans obstacles)
        private bool HasLineOfSight(Point from, Point to)
        {
            // Coordonnées de départ et d'arrivée
            int x0 = from.X;
            int y0 = from.Y;
            int x1 = to.X;
            int y1 = to.Y;

            // Différences absolues en X et Y
            int dx = Math.Abs(x1 - x0);
            int dy = Math.Abs(y1 - y0);

            // Direction du pas : +1 si on doit augmenter, -1 si on doit diminuer
            int sx = x0 < x1 ? 1 : -1;
            int sy = y0 < y1 ? 1 : -1;

            // Erreur initiale pour l'algorithme de tracé de ligne (Bresenham)
            int err = dx - dy;

            while (true)
            {
                // Ignore la cellule de départ, on ne veut pas la considérer comme obstacle
                if (!(x0 == from.X && y0 == from.Y))
                {
                    // Si cette cellule contient un obstacle, la ligne de vue est bloquée
                    if (obstacles.Contains(new Point(x0, y0)))
                        return false;
                }

                // Si on est arrivé à la cellule cible, on sort de la boucle
                if (x0 == x1 && y0 == y1)
                    break;

                // Calcul de l'erreur doublée pour déterminer le pas suivant
                int e2 = 2 * err;

                // On ajuste l'erreur et on avance en X si nécessaire
                if (e2 > -dy)
                {
                    err -= dy;
                    x0 += sx;
                }

                // On ajuste l'erreur et on avance en Y si nécessaire
                if (e2 < dx)
                {
                    err += dx;
                    y0 += sy;
                }
            }

            // Si aucun obstacle n'a été rencontré, il y a une ligne de vue
            return true;
        }


        // Retourne une liste des unités ennemies que le tireur peut viser
        private List<Unit> GetValidFireTargets(Unit shooter)
        {
            // Liste qui contiendra les cibles valides
            List<Unit> targets = new();

            // Parcours de toutes les unités ennemies
            foreach (var unit in enemyUnits)
            {
                // Calcul de la distance Manhattan entre le tireur et l'unité
                int distance =
                    Math.Abs(unit.Cell.X - shooter.Cell.X) +
                    Math.Abs(unit.Cell.Y - shooter.Cell.Y);

                // Si l'unité est hors portée de l'arme du tireur, on l'ignore
                if (distance > shooter.WeaponData.Range)
                    continue;

                // Vérifie s'il n'y a pas d'obstacle entre le tireur et la cible
                if (!HasLineOfSight(shooter.Cell, unit.Cell))
                    continue;

                // Si la cible est à portée et visible, on l'ajoute à la liste
                targets.Add(unit);
            }

            // Retourne toutes les cibles valides pour ce tir
            return targets;
        }


        // Met à jour la liste des cibles de tir disponibles pour l'unité sélectionnée
        void UpdateFireTargets()
        {
            // On vide d'abord les anciennes UI de cibles et la liste de cibles valides
            fireTargetsUI.Clear();     // UI graphique pour chaque cible
            validFireTargets.Clear();  // liste logique des cibles valides
            selectedFireTarget = null; // on désélectionne toute cible précédemment sélectionnée

            // Si aucune unité n'est sélectionnée, on sort
            if (selectedUnit == null)
                return;

            // Si l'unité sélectionnée n'est pas du joueur, on ne fait rien
            if (selectedUnit.Team != Team.Player)
                return;

            // Si l'unité n'a plus de points d'action, elle ne peut pas tirer
            if (selectedUnit.ActionPoints <= 0)
                return;

            // Récupère toutes les cibles valides pour le tir depuis cette unité
            validFireTargets = GetValidFireTargets(selectedUnit);

            // Affiche les cibles uniquement s'il y en a
            showFireTargets = validFireTargets.Count > 0;

            // Pour chaque cible valide, on crée son UI correspondante
            foreach (var target in validFireTargets)
            {
                // Calcul de la distance Manhattan entre le tireur et la cible
                int distance = Math.Abs(target.Cell.X - selectedUnit.Cell.X) +
                               Math.Abs(target.Cell.Y - selectedUnit.Cell.Y);

                // Calcul du pourcentage de chances de toucher
                int hitChance = Math.Max(selectedUnit.WeaponData.Accuracy - distance * 5, 10);
                // Limite minimale de chance de toucher à 10%

                // Position du rectangle de l'UI pour cette cible (empilement vertical au-dessus du bouton "TIRER")
                Rectangle bounds = new Rectangle(
                    fireButton.X,                           // même X que le bouton TIRER
                    fireButton.Y - 40 * (fireTargetsUI.Count + 1), // Y décalé vers le haut pour chaque nouvelle cible
                    fireButton.Width,                       // largeur identique au bouton
                    32                                      // hauteur fixe pour chaque cible
                );

                // Création et ajout de l'objet UI correspondant à la cible
                fireTargetsUI.Add(new FireTargetUI
                {
                    Target = target,     // unité cible
                    HitChance = hitChance, // chance de toucher calculée
                    Bounds = bounds       // rectangle de l'UI pour la souris
                });
            }
        }


        // Met à jour la position graphique (UI) des cibles de tir au-dessus du bouton "TIRER"
        private void UpdateFireTargetsUIPositions()
        {
            // Si aucune cible UI n'existe, rien à faire
            if (fireTargetsUI.Count == 0) return;

            int iconSize = 48;  // taille d'une icône de cible (largeur et hauteur)
            int spacing = 10;   // espacement entre les icônes

            // --- CENTRAGE HORIZONTAL ---
            // Calcul de la largeur totale du groupe d'icônes
            int totalWidth = fireTargetsUI.Count * iconSize + (fireTargetsUI.Count - 1) * spacing;

            // Coordonnée X de départ pour centrer le groupe au-dessus du bouton TIRER
            int startX = fireButton.X + (fireButton.Width - totalWidth) / 2;

            // Coordonnée Y fixe au-dessus du bouton TIRER, avec un petit décalage
            int y = fireButton.Y - iconSize - 10;

            // Boucle pour placer chaque icône de cible
            for (int i = 0; i < fireTargetsUI.Count; i++)
            {
                fireTargetsUI[i].Bounds = new Rectangle(
                    startX + i * (iconSize + spacing), // X = départ + décalage selon l'index
                    y,                                 // Y fixe au-dessus du bouton
                    iconSize,                          // largeur de l'icône
                    iconSize                           // hauteur de l'icône
                );
            }
        }


