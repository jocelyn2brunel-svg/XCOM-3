        private void CenterCameraOnPlayerSpawn()
        {
            // Centre la caméra sur le milieu du spawn des joueurs (y = gridHeight - 2)
            float centerX = (gridWidth / 2f) * cellSize;
            float centerY = (gridHeight - 2) * cellSize;
            cameraOffset = new Vector2(centerX, centerY);
        }

        private void HandleZoom()
        {
            float scrollDelta = (Mouse.GetState().ScrollWheelValue - previousScroll) / 120f;
            previousScroll += scrollDelta * 120f;
            if (scrollDelta != 0f)
                zoom = MathHelper.Clamp(zoom + scrollDelta * 0.1f, minZoom, maxZoom);
        }

        private void HandleCameraMovement(GameTime gameTime, MouseState mouse)
        {
            Vector2 move = Vector2.Zero;
            KeyboardState ks = Keyboard.GetState();
            if (ks.IsKeyDown(Keys.W)) move.Y -= 1;
            if (ks.IsKeyDown(Keys.S)) move.Y += 1;
            if (ks.IsKeyDown(Keys.A)) move.X -= 1;
            if (ks.IsKeyDown(Keys.D)) move.X += 1;
            if (move != Vector2.Zero) move.Normalize();
            cameraOffset += move * cameraSpeed * (float)gameTime.ElapsedGameTime.TotalSeconds;

            if (mouse.MiddleButton == ButtonState.Pressed)
                cameraOffset -= new Vector2(mouse.X - previousMouseState.X, mouse.Y - previousMouseState.Y) / zoom;
        }

