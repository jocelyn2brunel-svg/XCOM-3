        // Cette méthode crée toutes les unités quand une nouvelle partie commence
        private void CreateUnits()
        {
            // On commence par vider toutes les unités existantes
            playerUnits.Clear(); // Vide la liste de toutes les unités du joueur
            enemyUnits.Clear(); // Vide la liste de toutes les unités ennemies

            // ===== Création des unités du joueur =====
            for (int i = 0; i < 6; i++)
            {
                // Je crée un nouveau soldat et je l’ajoute à la liste du joueur
                playerUnits.Add(
                    new Unit(
                        new Point(2 + i, gridHeight - 2), // Position initiale (en bas de la map, espacée de 1 case horizontalement)
                        Team.Player, // Équipe du joueur
                        "Soldier " + (i + 1), // Nom de l’unité ("Soldier 1", "Soldier 2", ...) 1.5.1
                        "Assault", // Classe de l’unité (ici Assault) 1.5.1
                        "Rifle" // Arme de l’unité (ici Rifle) 1.5.1
                    )
                );
            }

            // ===== Création des unités ennemies =====
            for (int i = 0; i < 6; i++)
            {
                // Je choisis un template aléatoire dans le pool d’ennemis
                EnemyTemplate template =
                    enemyPool[random.Next(enemyPool.Count)];
                // Cela permet de varier le type d’ennemi, son arme et ses points d’action

                // Je crée une unité ennemie à partir du template
                enemyUnits.Add(
                    new Unit(
                        new Point(2 + i, 1), // Position initiale (en haut de la map, espacée de 1 case horizontalement) 1.5.3.4
                        Team.Enemy, // Équipe ennemie
                        template.Name, // Nom de l’unité selon le template
                        template.Class, // Classe selon le template
                        template.Weapon // Arme selon le template
                    )
                    {
                        ActionPoints = template.ActionPoints // Définir les points d’action selon le template
                    }
                );
            }
            // Message de debug pour confirmer la création des unités
            Console.WriteLine("Units created: 6 player, 6 enemy");
        }
        private void DrawUnits() // Dessine toutes les unités présentes sur la grille 1.5.0
        {
            foreach (var unit in playerUnits) // Parcourt toutes les unités du joueur
                DrawUnit(unit); // Appelle la fonction DrawUnit pour dessiner chaque unité du joueur
            foreach (var unit in enemyUnits) // Parcourt toutes les unités ennemies
                DrawUnit(unit); // Appelle la fonction DrawUnit pour dessiner chaque unité ennemie
        }
        private void DrawUnit(Unit unit) // Dessine une unité sur la grille 1.5.0
        {
            Rectangle rect = new Rectangle( // Crée un rectangle pour dessiner le "sprite" de l'unité.  On ajoute +4 et on retire 8 à la largeur/hauteur pour avoir un petit padding.  Cela permet de ne pas coller exactement au contour de la case de la grille
                unit.Cell.X * cellSize + 4 - (int)cameraOffset.X, // Position X = colonne * taille d'une case + padding
                unit.Cell.Y * cellSize + 4 - (int)cameraOffset.Y, // Position Y = ligne * taille d'une case + padding
                cellSize - 8, // Largeur = taille de case - padding
                cellSize - 8 // Hauteur = taille de case - padding
            );
            Color color = (unit.Team == Team.Player) // Détermine la couleur de l'unité selon son équipe
                ? Color.Blue // Joueur = bleu
                : Color.Red; // Ennemi = rouge
            _spriteBatch.Draw(pixel, rect, color); // Dessine le rectangle représentant l'unité

            // Animation de tir
            if (unit.IsFiring && unit.FireTarget.HasValue)
            {
                Point target = unit.FireTarget.Value;

                // Calcul de la position du projectile
                Vector2 start = new Vector2(unit.Cell.X + 0.5f, unit.Cell.Y + 0.5f) * cellSize;
                Vector2 end = new Vector2(target.X + 0.5f, target.Y + 0.5f) * cellSize;
                Vector2 pos = Vector2.Lerp(start, end, unit.FireProgress);

                pos -= cameraOffset;

                Rectangle proj = new Rectangle((int)pos.X - 4, (int)pos.Y - 4, 8, 8);
                _spriteBatch.Draw(pixel, proj, Color.Yellow);
            }

            if (unit == selectedUnit) // Si l'unité est sélectionnée, dessine une surbrillance autour 1.5.1
            {
                Rectangle outline = new Rectangle( // Rectangle pour l'outline (entoure toute la case, pas seulement le sprite)
                    unit.Cell.X * cellSize - (int)cameraOffset.X, // Position X de la case
                    unit.Cell.Y * cellSize - (int)cameraOffset.Y, // Position Y de la case
                    cellSize, // Largeur = taille d'une case
                    cellSize // Hauteur = taille d'une case
                );
                _spriteBatch.Draw(pixel, outline, new Color(0, 255, 255, 80)); // Dessine un rectangle semi-transparent cyan pour montrer la sélection
            }
        }

        private IEnumerable<Unit> AllUnits()
        {
            foreach (var u in playerUnits) yield return u; // Parcourt toutes les unités du joueur, "yield return" renvoie chaque unité une par une sans créer une nouvelle liste
            foreach (var u in enemyUnits) yield return u; // Parcourt toutes les unités ennemies, renvoie chaque unité ennemie également
        }

        private Unit GetUnitAtCell(Point cell)
        {
            foreach (var unit in AllUnits()) // Parcourt toutes les unités du jeu (joueur + ennemis)
                if (unit.Cell == cell) // Vérifie si l'unité est sur la case demandée
                    return unit; // Si oui, retourne cette unité immédiatement
            return null; // Si aucune unité n'est trouvée sur cette case, retourne null
        }

